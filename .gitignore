*.py[cod]
*$py.class
dist/
build/
*.egg-info/
.venv/
venv/
env/

# IDE, Scratch and Environment
.vscode/
.idea/
scratch/
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Database artifacts
*.sqlite-shm
*.sqlite-wal

# Test caches & coverage
.pytest_cache/
.coverage
htmlcov/

