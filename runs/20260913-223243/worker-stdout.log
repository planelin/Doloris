{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$root = Join-Path (Get-Location) '\"'decisionlab'\n\"'$cssPath = Join-Path $root '\"'assets\\\\style.css'\n\n\"'$css = @'\"'\n:root {\n  color-scheme: dark;\n  --bg: #050b10;\n  --bg-deep: #020609;\n  --surface: #0a151c;\n  --surface-raised: #0d1d25;\n  --text: #e8fbf6;\n  --muted: #86a8a5;\n  --line: rgba(63, 255, 215, 0.18);\n  --line-strong: rgba(63, 255, 215, 0.38);\n  --accent: #2ef2d0;\n  --accent-strong: #7dffe0;\n  --accent-green: #8dff5a;\n  --accent-soft: rgba(46, 242, 208, 0.11);\n  --danger: #ff5f8f;\n  --shadow: 0 22px 60px rgba(0, 0, 0, 0.5);\n  --glow: 0 0 22px rgba(46, 242, 208, 0.22);\n  --radius: 18px;\n  --max-width: 1120px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  position: relative;\n  margin: 0;\n  min-height: 100vh;\n  overflow-x: hidden;\n  background:\n    radial-gradient(circle at 12% 8%, rgba(46, 242, 208, 0.09), transparent 34rem),\n    radial-gradient(circle at 92% 32%, rgba(141, 255, 90, 0.06), transparent 30rem),\n    linear-gradient(180deg, var(--bg), var(--bg-deep));\n  color: var(--text);\n  font-family: \\\"Segoe UI\\\", \\\"PingFang SC\\\", \\\"Microsoft YaHei\\\", sans-serif;\n  line-height: 1.7;\n}\n\nbody::before {\n  position: fixed;\n  inset: 0;\n  z-index: -1;\n  background-image:\n    linear-gradient(rgba(46, 242, 208, 0.035) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(46, 242, 208, 0.035) 1px, transparent 1px);\n  background-size: 44px 44px;\n  content: \\\"\\\";\n  pointer-events: none;\n  mask-image: linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.55) 60%, transparent 100%);\n}\n\n::selection {\n  background: rgba(46, 242, 208, 0.32);\n  color: #fff;\n}\n\na {\n  color: inherit;\n}\n\n:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 3px;\n}\n\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  width: min(100% - 40px, var(--max-width));\n  margin: 0 auto;\n  padding: 20px 0;\n  background: rgba(5, 11, 16, 0.76);\n  border-bottom: 1px solid rgba(46, 242, 208, 0.1);\n  backdrop-filter: blur(16px);\n}\n\n.brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  font-weight: 800;\n  text-decoration: none;\n  letter-spacing: 0.02em;\n  white-space: nowrap;\n}\n\n.brand-mark {\n  display: grid;\n  width: 38px;\n  height: 38px;\n  place-items: center;\n  border: 1px solid rgba(46, 242, 208, 0.55);\n  border-radius: 11px;\n  background: linear-gradient(135deg, rgba(46, 242, 208, 0.2), rgba(141, 255, 90, 0.08));\n  box-shadow: var(--glow);\n  color: var(--accent-strong);\n  font-size: 0.78rem;\n  letter-spacing: 0.08em;\n}\n\n.site-nav {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 6px;\n}\n\n.site-nav a {\n  position: relative;\n  padding: 7px 10px;\n  border: 1px solid transparent;\n  border-radius: 9px;\n  color: var(--muted);\n  font-size: 0.9rem;\n  text-decoration: none;\n  transition: color 160ms ease, border-color 160ms ease, background 160ms ease;\n}\n\n.site-nav a:hover,\n.site-nav a[aria-current=\\\"page\\\"] {\n  border-color: var(--line);\n  background: var(--accent-soft);\n  color: var(--accent-strong);\n  text-shadow: 0 0 12px rgba(46, 242, 208, 0.55);\n}\n\nmain,\n.site-footer {\n  width: min(100% - 40px, var(--max-width));\n  margin-inline: auto;\n}\n\n.hero {\n  padding: clamp(64px, 12vw, 132px) 0 72px;\n}\n\n.eyebrow {\n  margin: 0 0 12px;\n  color: var(--accent);\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.16em;\n  text-shadow: 0 0 14px rgba(46, 242, 208, 0.45);\n  text-transform: uppercase;\n}\n\nh1,\nh2,\nh3,\np {\n  margin-top: 0;\n}\n\nh1 {\n  max-width: 880px;\n  margin-bottom: 24px;\n  font-size: clamp(2.35rem, 7vw, 5.8rem);\n  line-height: 1.02;\n  letter-spacing: -0.055em;\n}\n\nh1::after {\n  display: block;\n  width: min(180px, 40vw);\n  height: 2px;\n  margin-top: 22px;\n  background: linear-gradient(90deg, var(--accent), var(--accent-green), transparent);\n  box-shadow: 0 0 16px rgba(46, 242, 208, 0.65);\n  content: \\\"\\\";\n}\n\nh2 {\n  font-size: clamp(1.7rem, 4vw, 2.8rem);\n  line-height: 1.15;\n  letter-spacing: -0.035em;\n}\n\nh3 {\n  font-size: 1.25rem;\n}\n\n.lead {\n  max-width: 720px;\n  color: var(--muted);\n  font-size: clamp(1.05rem, 2.3vw, 1.3rem);\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 32px;\n}\n\n.button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 46px;\n  padding: 0 18px;\n  border: 1px solid var(--line-strong);\n  border-radius: 999px;\n  text-decoration: none;\n  font-weight: 700;\n  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;\n}\n\n.button:hover {\n  box-shadow: var(--glow);\n  transform: translateY(-1px);\n}\n\n.button-primary {\n  border-color: var(--accent);\n  background: linear-gradient(120deg, var(--accent), var(--accent-green));\n  color: #03100d;\n}\n\n.button-secondary {\n  background: rgba(10, 21, 28, 0.72);\n  color: var(--accent-strong);\n}\n\n.section-block {\n  padding: 70px 0 96px;\n  border-top: 1px solid var(--line);\n}\n\n.section-heading {\n  max-width: 650px;\n  margin-bottom: 30px;\n}\n\n.section-heading > p:last-child {\n  color: var(--muted);\n}\n\n.card-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.card {\n  position: relative;\n  display: flex;\n  min-height: 270px;\n  flex-direction: column;\n  align-items: flex-start;\n  overflow: hidden;\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background:\n    linear-gradient(150deg, rgba(46, 242, 208, 0.065), transparent 42%),\n    var(--surface);\n  box-shadow: var(--shadow);\n  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n}\n\n.card::after {\n  position: absolute;\n  right: -40px;\n  bottom: -60px;\n  width: 130px;\n  height: 130px;\n  border: 1px solid rgba(141, 255, 90, 0.18);\n  border-radius: 50%;\n  content: \\\"\\\";\n}\n\n.card:hover {\n  border-color: var(--line-strong);\n  box-shadow: var(--shadow), var(--glow);\n  transform: translateY(-3px);\n}\n\n.card-index {\n  margin-bottom: auto;\n  color: var(--accent-green);\n  font-size: 0.76rem;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-shadow: 0 0 12px rgba(141, 255, 90, 0.5);\n}\n\n.card h3 {\n  margin-top: 30px;\n  margin-bottom: 8px;\n}\n\n.card p {\n  color: var(--muted);\n  font-size: 0.94rem;\n}\n\n.text-link {\n  margin-top: auto;\n  color: var(--accent);\n  font-weight: 700;\n  text-decoration: none;\n}\n\n.text-link:hover {\n  color: var(--accent-green);\n}\n\n.site-footer {\n  display: flex;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 32px 0 48px;\n  border-top: 1px solid var(--line);\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n\n.site-footer p {\n  margin: 0;\n}\n\n.page-hero {\n  padding: clamp(48px, 9vw, 96px) 0 48px;\n  border-bottom: 1px solid var(--line);\n}\n\n.page-hero h1 {\n  margin-bottom: 18px;\n}\n\n.page-hero .lead {\n  margin-bottom: 0;\n}\n\n.article {\n  display: grid;\n  gap: 8px;\n  padding: 24px 0 8px;\n}\n\n.article-section {\n  padding: 40px 0;\n  border-bottom: 1px solid var(--line);\n}\n\n.article-section h2 {\n  max-width: 760px;\n  margin-bottom: 20px;\n  font-size: clamp(1.4rem, 3vw, 2.05rem);\n}\n\n.article-section h2::before {\n  margin-right: 10px;\n  color: var(--accent-green);\n  content: \\\"//\\\";\n  text-shadow: 0 0 12px rgba(141, 255, 90, 0.6);\n}\n\n.article-section p {\n  max-width: 74ch;\n  margin-bottom: 18px;\n  color: var(--muted);\n  font-size: 1.05rem;\n}\n\n.article-section p:last-child {\n  margin-bottom: 0;\n}\n\n.pager {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 40px 0 8px;\n}\n\n.pager a {\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  padding: 0 18px;\n  border: 1px solid var(--line-strong);\n  border-radius: 999px;\n  background: rgba(10, 21, 28, 0.8);\n  color: var(--text);\n  font-weight: 700;\n  text-decoration: none;\n  transition: border-color 160ms ease, box-shadow 160ms ease, color 160ms ease;\n}\n\n.pager a:hover {\n  border-color: var(--accent);\n  box-shadow: var(--glow);\n  color: var(--accent-strong);\n}\n\n.pager .pager-next {\n  border-color: var(--accent);\n  background: linear-gradient(120deg, var(--accent), var(--accent-green));\n  color: #03100d;\n}\n\n.pager .pager-next:hover {\n  color: #03100d;\n}\n\n@media (max-width: 900px) {\n  .card-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 720px) {\n  .site-header {\n    position: static;\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .site-nav {\n    justify-content: flex-start;\n  }\n\n  .hero {\n    padding-top: 42px;\n  }\n\n  .card-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .card {\n    min-height: 230px;\n  }\n\n  .site-footer {\n    flex-direction: column;\n  }\n\n  .pager {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .pager a {\n    justify-content: center;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n\n  *,\n  *::before,\n  *::after {\n    transition-duration: 0.01ms \"'!important;\n  }\n}\n'\"'@\n\nSet-Content -LiteralPath \"'$cssPath -Value $css -Encoding UTF8\n\n$htmlFiles = @(\n  (Join-Path $root '\"'index.html'),\n  (Join-Path \"'$root '\"'pages\\\\01-heartbeat.html'),\n  (Join-Path \"'$root '\"'pages\\\\02-takeover.html'),\n  (Join-Path \"'$root '\"'pages\\\\03-decision.html'),\n  (Join-Path \"'$root '\"'pages\\\\04-report.html')\n)\n\nforeach (\"'$file in $htmlFiles) {\n  $content = Get-Content -LiteralPath $file -Raw -Encoding UTF8\n  if ($content -notmatch '\"'data-theme=\\\"cyber\\\"') {\n    \"'$content = $content -replace '\"'<html lang=\\\"zh-CN\\\">', '<html lang=\\\"zh-CN\\\" data-theme=\\\"cyber\\\">'\n  }\n  if (\"'$content -notmatch '\"'name=\\\"theme-color\\\"') {\n    \"'$content = $content -replace '\"'(<meta name=\\\"viewport\\\" content=\\\"[\"'^\"]*\">)'\"', \\\"\"'`$1`r`n  <meta name=`\"theme-color`\" content=`\"#050b10`\">\"\n  }\n  Set-Content -LiteralPath $file -Value $content -Encoding UTF8\n}\n\n$progressPath = Join-Path $root '\"'PROGRESS.md'\n\"'$progress = @'\"'\n# 决策实验站进度\n\n- [x] 基建\n- [x] 内容页\n- [x] 主题应用\n- [ ] 语言应用\n- [ ] 配置记录\n- [ ] 说明文档\n'@\nSet-Content -LiteralPath \"'$progressPath -Value $progress -Encoding UTF8\n\nGet-Item -LiteralPath $cssPath | Select-Object FullName,Length\nGet-Content -LiteralPath $progressPath -Encoding UTF8\nSelect-String -LiteralPath $htmlFiles -Pattern '\"'data-theme=\\\"cyber\\\"|theme-color' | Select-Object Path,LineNumber,Line\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
