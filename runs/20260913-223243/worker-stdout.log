{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$root = Join-Path (Get-Location) '\"'decisionlab'\n\"'$files = @((Join-Path $root '\"'index.html')) + (Get-ChildItem -LiteralPath (Join-Path \"'$root '\"'pages') -Filter '*.html' | ForEach-Object { \"'$_.FullName })\n$latin = @()\nforeach ($file in $files) {\n  $content = Get-Content -LiteralPath $file -Raw -Encoding UTF8\n  foreach ($m in [regex]::Matches($content, '\"'>([\"'^<>]*[A-Za-z][''^<>]*)<'\"')) {\n    \"'$text = $m.Groups[1].Value.Trim()\n    if ($text) { $latin += [pscustomobject]@{ File = (Split-Path $file -Leaf); Text = $text } }\n  }\n}\nif ($latin.Count -eq 0) { Write-Output '\"'可见文案：无残留拉丁字母文本' } else { \"'$latin | Format-Table -AutoSize }\n\nWrite-Output '\"'--- config.json 校验 ---'\n\"'$json = Get-Content -LiteralPath (Join-Path $root '\"'data\\\\config.json') -Raw -Encoding UTF8 | ConvertFrom-Json\nWrite-Output (\\\"theme = {0}\\\" -f \"'$json.theme)\nWrite-Output (\"lang  = {0}\" -f $json.lang)\n\nWrite-Output '\"'--- 链接完整性校验 ---'\n\"'$all = $files + (Join-Path $root '\"'README.md')\n\"'$missing = @()\nforeach ($file in $files) {\n  $content = Get-Content -LiteralPath $file -Raw -Encoding UTF8\n  foreach ($m in [regex]::Matches($content, '\"'href=\\\"([\"'^\"#]+)(#[''^\"]*)?\"'\"')) {\n    \"'$href = $m.Groups[1].Value\n    if ($href -match '\"'\"'^(https?:|mailto:)'\"') { continue }\n    \"'$target = Join-Path (Split-Path $file -Parent) $href\n    if (-not (Test-Path -LiteralPath $target)) { $missing += \"$(Split-Path $file -Leaf) -> $href\" }\n  }\n}\nif ($missing.Count -eq 0) { Write-Output '\"'所有页面链接均可解析' } else { \"'$missing }\nWrite-Output '\"'--- PROGRESS.md ---'\nGet-Content -LiteralPath (Join-Path \"'$root '\"'PROGRESS.md') -Encoding UTF8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
