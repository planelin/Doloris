eight: 1.02;\n  letter-spacing: -0.055em;\n}\n\nh1::after {\n  display: block;\n  width: min(180px, 40vw);\n  height: 2px;\n  margin-top: 22px;\n  background: linear-gradient(90deg, var(--accent), var(--accent-green), transparent);\n  box-shadow: 0 0 16px rgba(46, 242, 208, 0.65);\n  content: \\\"\\\";\n}\n\nh2 {\n  font-size: clamp(1.7rem, 4vw, 2.8rem);\n  line-height: 1.15;\n  letter-spacing: -0.035em;\n}\n\nh3 {\n  font-size: 1.25rem;\n}\n\n.lead {\n  max-width: 720px;\n  color: var(--muted);\n  font-size: clamp(1.05rem, 2.3vw, 1.3rem);\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 32px;\n}\n\n.button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 46px;\n  padding: 0 18px;\n  border: 1px solid var(--line-strong);\n  border-radius: 999px;\n  text-decoration: none;\n  font-weight: 700;\n  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;\n}\n\n.button:hover {\n  box-shadow: var(--glow);\n  transform: translateY(-1px);\n}\n\n.button-primary {\n  border-color: var(--accent);\n  background: linear-gradient(120deg, var(--accent), var(--accent-green));\n  color: #03100d;\n}\n\n.button-secondary {\n  background: rgba(10, 21, 28, 0.72);\n  color: var(--accent-strong);\n}\n\n.section-block {\n  padding: 70px 0 96px;\n  border-top: 1px solid var(--line);\n}\n\n.section-heading {\n  max-width: 650px;\n  margin-bottom: 30px;\n}\n\n.section-heading > p:last-child {\n  color: var(--muted);\n}\n\n.card-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.card {\n  position: relative;\n  display: flex;\n  min-height: 270px;\n  flex-direction: column;\n  align-items: flex-start;\n  overflow: hidden;\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background:\n    linear-gradient(150deg, rgba(46, 242, 208, 0.065), transparent 42%),\n    var(--surface);\n  box-shadow: var(--shadow);\n  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n}\n\n.card::after {\n  position: absolute;\n  right: -40px;\n  bottom: -60px;\n  width: 130px;\n  height: 130px;\n  border: 1px solid rgba(141, 255, 90, 0.18);\n  border-radius: 50%;\n  content: \\\"\\\";\n}\n\n.card:hover {\n  border-color: var(--line-strong);\n  box-shadow: var(--shadow), var(--glow);\n  transform: translateY(-3px);\n}\n\n.card-index {\n  margin-bottom: auto;\n  color: var(--accent-green);\n  font-size: 0.76rem;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-shadow: 0 0 12px rgba(141, 255, 90, 0.5);\n}\n\n.card h3 {\n  margin-top: 30px;\n  margin-bottom: 8px;\n}\n\n.card p {\n  color: var(--muted);\n  font-size: 0.94rem;\n}\n\n.text-link {\n  margin-top: auto;\n  color: var(--accent);\n  font-weight: 700;\n  text-decoration: none;\n}\n\n.text-link:hover {\n  color: var(--accent-green);\n}\n\n.site-footer {\n  display: flex;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 32px 0 48px;\n  border-top: 1px solid var(--line);\n  color: var(--muted);\n  font-size: 0.9rem;\n}\n\n.site-footer p {\n  margin: 0;\n}\n\n.page-hero {\n  padding: clamp(48px, 9vw, 96px) 0 48px;\n  border-bottom: 1px solid var(--line);\n}\n\n.page-hero h1 {\n  margin-bottom: 18px;\n}\n\n.page-hero .lead {\n  margin-bottom: 0;\n}\n\n.article {\n  display: grid;\n  gap: 8px;\n  padding: 24px 0 8px;\n}\n\n.article-section {\n  padding: 40px 0;\n  border-bottom: 1px solid var(--line);\n}\n\n.article-section h2 {\n  max-width: 760px;\n  margin-bottom: 20px;\n  font-size: clamp(1.4rem, 3vw, 2.05rem);\n}\n\n.article-section h2::before {\n  margin-right: 10px;\n  color: var(--accent-green);\n  content: \\\"//\\\";\n  text-shadow: 0 0 12px rgba(141, 255, 90, 0.6);\n}\n\n.article-section p {\n  max-width: 74ch;\n  margin-bottom: 18px;\n  color: var(--muted);\n  font-size: 1.05rem;\n}\n\n.article-section p:last-child {\n  margin-bottom: 0;\n}\n\n.pager {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 40px 0 8px;\n}\n\n.pager a {\n  display: inline-flex;\n  align-items: center;\n  min-height: 44px;\n  padding: 0 18px;\n  border: 1px solid var(--line-strong);\n  border-radius: 999px;\n  background: rgba(10, 21, 28, 0.8);\n  color: var(--text);\n  font-weight: 700;\n  text-decoration: none;\n  transition: border-color 160ms ease, box-shadow 160ms ease, color 160ms ease;\n}\n\n.pager a:hover {\n  border-color: var(--accent);\n  box-shadow: var(--glow);\n  color: var(--accent-strong);\n}\n\n.pager .pager-next {\n  border-color: var(--accent);\n  background: linear-gradient(120deg, var(--accent), var(--accent-green));\n  color: #03100d;\n}\n\n.pager .pager-next:hover {\n  color: #03100d;\n}\n\n@media (max-width: 900px) {\n  .card-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 720px) {\n  .site-header {\n    position: static;\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .site-nav {\n    justify-content: flex-start;\n  }\n\n  .hero {\n    padding-top: 42px;\n  }\n\n  .card-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .card {\n    min-height: 230px;\n  }\n\n  .site-footer {\n    flex-direction: column;\n  }\n\n  .pager {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .pager a {\n    justify-content: center;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n\n  *,\n  *::before,\n  *::after {\n    transition-duration: 0.01ms \"'!important;\n  }\n}\n'\"'@\n\nSet-Content -LiteralPath \"'$cssPath -Value $css -Encoding UTF8\n\n$htmlFiles = @(\n  (Join-Path $root '\"'index.html'),\n  (Join-Path \"'$root '\"'pages\\\\01-heartbeat.html'),\n  (Join-Path \"'$root '\"'pages\\\\02-takeover.html'),\n  (Join-Path \"'$root '\"'pages\\\\03-decision.html'),\n  (Join-Path \"'$root '\"'pages\\\\04-report.html')\n)\n\nforeach (\"'$file in $htmlFiles) {\n  $content = Get-Content