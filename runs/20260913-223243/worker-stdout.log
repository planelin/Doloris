{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$root = Join-Path (Get-Location) '\"'decisionlab'\n\"'$fixes = @(\n  @{ File = Join-Path $root '\"'pages\\\\01-heartbeat.html'; From = 'TTAGE 01 / HEARTBEAT'; To = '阶段 01 / 心跳检测' },\n  @{ File = Join-Path \"'$root '\"'pages\\\\02-takeover.html';  From = 'TTAGE 02 / TAKEOVER';  To = '阶段 02 / 会话接管' },\n  @{ File = Join-Path \"'$root '\"'pages\\\\03-decision.html';  From = 'TTAGE 03 / DECITION';  To = '阶段 03 / 决策代理' },\n  @{ File = Join-Path \"'$root '\"'pages\\\\04-report.html';    From = 'TTAGE 04 / REPORT';    To = '阶段 04 / 终态报告' }\n)\nforeach (\"'$f in $fixes) {\n  $content = Get-Content -LiteralPath $f.File -Raw -Encoding UTF8\n  if (-not $content.Contains($f.From)) { Write-Output \"未找到预期文本：$($f.From)\"; continue }\n  $content = $content.Replace($f.From, $f.To)\n  Set-Content -LiteralPath $f.File -Value $content -Encoding UTF8\n}\nGet-ChildItem -LiteralPath (Join-Path $root '\"'pages') -Filter '*.html' | ForEach-Object {\n  Write-Output \\\"===== \"'$($_.Name)\"\n  Select-String -LiteralPath $_.FullName -Pattern '\"'eyebrow|brand-mark' | ForEach-Object { \"'$_.Line.Trim() }\n}'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
