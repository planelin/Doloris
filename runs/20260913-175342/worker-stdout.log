bda:c.load_profile(root/'profiles/taki.json'))\nprofile_test('profile_duplicate_semantics_rejected',lambda p:p['parts']['legs'].append(p['parts']['head'][0]))\nprofile_test('profile_missing_role_rejected',lambda p:p['parts'].pop('hair'))\nprofile_test('profile_other_up_axis_rejected',lambda p:p['coordinate_contract'].update(up='+Y'))\nprofile_test('profile_nan_width_rejected',lambda p:p['face'].update(width_height_ratio=float('nan')))\nprofile_test('profile_noninteger_frames_rejected',lambda p:p['collision'].update(frames=95.5))\nprofile_test('profile_infinite_fps_rejected',lambda p:p['collision'].update(fps=float('inf')))\nprofile_test('profile_bool_influence_limit_rejected',lambda p:p['weights'].update(max_influences=True))\nprofile_test('profile_unqualified_seam_rejected',lambda p:p['face'].update(seam_mode='recessed_collar'))\ncheck('restore_checkpoint_hash_matches',lambda:equal(c.sha256_file(root/'runs/taki_restore_check/face.blend'),json.loads((root/'runs/taki_restore_check/face.json').read_text(encoding='utf-8'))['checkpoint']['sha256']))\ncheck('restore_profile_hash_matches_current',lambda:equal(c.sha256_file(root/'profiles/taki.json'),json.loads((root/'runs/taki_restore_check/face.json').read_text(encoding='utf-8'))['profile_sha256']))\nprint(json.dumps({'mode':'READ_ONLY_MEMORY_ONLY','total':len(results),'passed':sum(r['status']=='PASS' for r in results),'failed':sum(r['status']=='FAIL' for r in results),'results':results},indent=2))\n'@ | & 'C:\\\\blender\\\\blender-4.3.2-windows-x64\\\\4.3\\\\python\\\\bin\\\\python.exe' -B -\"","aggregated_output":"{\r\n  \"mode\": \"READ_ONLY_MEMORY_ONLY\",\r\n  \"total\": 38,\r\n  \"passed\": 30,\r\n  \"failed\": 8,\r\n  \"results\": [\r\n    {\r\n      \"case\": \"all_10_scripts_parse\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"frames_include_96_at_step4\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"every_frame_means_96_samples\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"zero_frame_step_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"negative_frame_step_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"bool_frame_step_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"reversed_frames_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"one_frame_valid\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"bool_frame_start_rejected\",\r\n      \"status\": \"FAIL\",\r\n      \"error\": \"Invalid input was accepted\"\r\n    },\r\n    {\r\n      \"case\": \"weight_empty_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"weight_nan_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"weight_infinity_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"weight_negative_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"weight_topn_deterministic\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"bool_influence_limit_rejected\",\r\n      \"status\": \"FAIL\",\r\n      \"error\": \"Invalid input was accepted\"\r\n    },\r\n    {\r\n      \"case\": \"negative_weight_epsilon_rejected\",\r\n      \"status\": \"FAIL\",\r\n      \"error\": \"Invalid input was accepted\"\r\n    },\r\n    {\r\n      \"case\": \"finite_weight_sum_overflow_handled\",\r\n      \"status\": \"FAIL\",\r\n      \"error\": \"{'a': 0.0, 'b': 0.0}\"\r\n    },\r\n    {\r\n      \"case\": \"path_child_accepted\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"path_parent_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"path_root_itself_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"case\": \"sibling_prefix_rejected\",\r\n      \"status\": \"PASS\"\r\n    },\r\n    {\r\n      \"ca