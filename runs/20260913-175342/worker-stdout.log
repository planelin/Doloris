{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$p='\"'C:\\\\Agents\\\\zcode\\\\double\\\\afk-work\\\\PROGRESS.md'; if (Test-Path -LiteralPath \"'$p) { Get-Content -LiteralPath $p -Encoding UTF8 } else { Write-Output '\"'PROGRESS.md remains absent; filesystem policy is read-only.' }; Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\scripts\\\\geometry_probe.py' -Encoding UTF8; Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\scripts\\\\repair_face.py' -Encoding UTF8 | Select-Object -First 90; Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\experiments\\\\refine_face_seam.py' -Encoding UTF8\"","aggregated_output":"PROGRESS.md remains absent; filesystem policy is read-only.\r\n\"\"\"Geometric probes with stated preconditions; nearest normal sign is not inside/outside.\r\nThree independent ray parity directions agree or the sample is AMBIGUOUS.\r\n\"\"\"\r\nimport math\r\nimport bpy\r\nimport bmesh\r\nfrom mathutils import Vector\r\nfrom mathutils.bvhtree import BVHTree\r\nfrom contracts import require\r\n\r\nRAY_DIRECTIONS = [Vector((1.0,.317,.173)).normalized(), Vector((.137,1.0,.419)).normalized(), Vector((.271,.193,1.0)).normalized()]\r\n\r\n\r\ndef evaluated_surface(ob, depsgraph):\r\n    evaluated=ob.evaluated_get(depsgraph)\r\n    mesh=evaluated.to_mesh()\r\n    try:\r\n        mesh.calc_loop_triangles()\r\n        return ([evaluated.matrix_world@v.co for v in mesh.vertices], [tuple(t.vertices) for t in mesh.loop_triangles], [tuple(e.vertices) for e in mesh.edges])\r\n    finally:\r\n        evaluated.to_mesh_clear()\r\n\r\n\r\ndef collider_contract(vertices,triangles):\r\n    bm=bmesh.new()\r\n    try:\r\n        vs=[bm.verts.new(v) for v in vertices]\r\n        for tri in triangles:bm.faces.new([vs[i] for i in tri])\r\n        bm.normal_update()\r\n        return {\"boundary_edges\":sum(e.is_boundary for e in bm.edges),\"non_manifold_edges\":sum(not e.is_manifold for e in bm.edges),\r\n                \"non_manifold_vertices\":sum(not v.is_manifold for v in bm.verts),\"orientation_conflicts\":sum(e.is_manifold and not e.is_contiguous for e in bm.edges),\r\n                \"degenerate_triangles\":sum(f.calc_area()<1e-12 for f in bm.faces)}\r\n    finally:bm.free()\r\n\r\n\r\ndef aabb(points):\r\n    return Vector(tuple(min(p[i] for p in points) for i in range(3))),Vector(tuple(max(p[i] for p in points) for i in range(3)))\r\n\r\n\r\ndef ray_parity(tree,point,direction,extent,epsilon):\r\n    origin=point.copy();count=0;travel=0.0\r\n    for _ in range(256):\r\n        loc,normal,index,distance=tree.ray_cast(origin,direction,extent-travel)\r\n        if loc is None:return count%2\r\n        count+=1\r\n        step=distance+epsilon\r\n        travel+=step\r\n        if travel>=extent:return count%2\r\n        origin=loc+direction*epsilon\r\n    return None\r\n\r\n\r\ndef point_state(tree,point,bounds,tolerance):\r\n    low,high=bounds\r\n    if any(point[i]<low[i]-tolerance or point[i]>high[i]+tolerance for i in range(3)):\r\n        return \"OUTSIDE\",None,None\r\n    nearest,normal,index,distance=tree.find_nearest(point)\r\n    if nearest is None:return \"AMBIGUOUS\",None,None\r\n    if distance<=tolerance:return \"CONTACT\",distance,nearest\r\n    extent=(high-low).length*3+1\r\n    eps=max(tolerance*.1,1e-8)\r\n    parities=[ray_parity(tree,point,d,extent,eps) for d in RAY_DIRECTIONS]\r\n    if None in parities or len(set(parities))!=1:return \"AMBIGUOUS\",distance,nearest\r\n    return (\"INSIDE\" if parities[0] else \"OUTSIDE\"),distance,nearest\r\n\r\n\r\ndef samples(vertices,triangles,edges):\r\n    for p in vertices:yield \"vertex\",p\r\n    for a,b in edges:yield \"edge_midpoint\",(vertices[a]+vertices[b])*.5\r\n    for a,b,c in triangles:yield \"triangle_centroid\",(vertices[a]+vertices[b]+vertices[c])/3\r\n\r\n\r\ndef segment_triangle(a,b,t,epsilon=1e-9):\r\n    \"\"\"Two-sided Moller-Trumbore over a finite segment. Coplanar -> None.\"\"\"\r\n    p0,p1,p2=t;d=b-a;e1=p1-p0;e2=p2-p0;h=d.cross(e2);det=e1.dot(h)\r\n    scale=max(d.length*e1.length*e2.length,1e-18)\r\n    if abs(det)<=epsilon*scale:return None\r\n    inv=1/det;s=a-p0;u=s.dot(h)*inv\r\n    if u < -epsilon or u > 1+epsilon:return False\r\n    q=s.cross(e1);v=d.dot(q)*inv\r\n    if v < -epsilon or u+v > 1+epsilon:return False\r\n    f=e2.dot(q)*inv\r\n    return -epsilon<=f<=1+epsilon\r\n\r\n\r\ndef triangles_intersect(a,b):\r\n    values=[]\r\n    for i in range(3):values.append(segment_triangle(a[i],a[(i+1)%3],b))\r\n    for i in range(3):values.append(segment_triangle(b[i],b[(i+1)%3],a))\r\n    if any(x is True for x in values):return \"INTERSECTION\"\r\n    # Coplanar overlap candidates remain explicitly uncertain instead of false CLEAN.\r\n    na=(a[1]-a[0]).cross(a[2]-a[0]);nb=(b[1]-b[0]).cross(b[2]-b[0])\r\n    if na.length<1e-14 or nb.length<1e-14:return \"DEGENERATE\"\r\n    if abs(abs(na.normalized().dot(nb.normalized()))-1)<1e-7 and abs((b[0]-a[0]).dot(na.normalized()))<1e-8:return \"COPLANAR_CANDIDATE\"\r\n    return \"NONE\"\r\n\r\n\r\ndef self_intersections(vertices,triangles):\r\n    tree=BVHTree.FromPolygons(vertices,triangles,all_triangles=True)\r\n    pairs=sorted({(min(a,b),max(a,b)) for a,b in tree.overlap(tree) if a!=b and not set(triangles[a]).intersection(triangles[b])})\r\n    hits=[];uncertain=[]\r\n    for a,b in pairs:\r\n        state=triangles_intersect([vertices[i] for i in triangles[a]],[vertices[i] for i in triangles[b]])\r\n        if state==\"INTERSECTION\":hits.append((a,b))\r\n        elif state in {\"COPLANAR_CANDIDATE\",\"DEGENERATE\"}:uncertain.append((a,b,state))\r\n    return {\"nonadjacent_triangle_intersections\":len(hits),\"uncertain_pairs\":len(uncertain),\"intersections\":hits[:40],\"uncertain\":uncertain[:40],\"bvh_candidates\":len(pairs)}\r\n\r\n\r\ndef probe_collision(cloth_surface,collider_surface,tolerance,check_self=True):\r\n    cv,ct,ce=cloth_surface;lv,lt,le=collider_surface\r\n    contract=collider_contract(lv,lt)\r\n    valid=all(value==0 for value in contract.values())\r\n    selfcheck=self_intersections(lv,lt) if valid and check_self else None\r\n    if selfcheck and (selfcheck[\"nonadjacent_triangle_intersections\"] or selfcheck[\"uncertain_pairs\"]):valid=False\r\n    # Pair intersections remain useful evidence even if inside/outside is undefined.\r\n    ltree=BVHTree.FromPolygons(lv,lt,all_triangles=True)\r\n    ctree=BVHTree.FromPolygons(cv,ct,all_triangles=True)\r\n    overlap=ctree.overlap(ltree)\r\n    cross=0;uncertain_cross=0\r\n    for ci,li in overlap:\r\n        state=triangles_intersect([cv[i] for i in ct[ci]],[lv[i] for i in lt[li]])\r\n        cross+=state==\"INTERSECTION\"\r\n        uncertain_cross+=state in {\"COPLANAR_CANDIDATE\",\"DEGENERATE\"}\r\n    counts={kind:{state:0 for state in (\"INSIDE\",\"OUTSIDE\",\"CONTACT\",\"AMBIGUOUS\")} for kind in (\"vertex\",\"edge_midpoint\",\"triangle_centroid\")}\r\n    worst=0.0;tested=0\r\n    if valid:\r\n        bounds=aabb(lv)\r\n        for kind,point in samples(cv,ct,ce):\r\n            state,distance,_=point_state(ltree,point,bounds,tolerance)\r\n            counts[kind][state]+=1;tested+=1\r\n            if state==\"INSIDE\":worst=max(worst,distance or 0)\r\n    inside=sum(row[\"INSIDE\"] for row in counts.values());ambiguous=sum(row[\"AMBIGUOUS\"] for row in counts.values())\r\n    status=\"INVALID_COLLIDER\" if not valid else \"PENETRATING\" if inside or cross else \"INCONCLUSIVE\" if ambiguous or uncertain_cross else \"SAMPLED_CLEAR\"\r\n    return {\"status\":status,\"collider_contract\":contract,\"collider_self_intersections\":selfcheck,\"samples\":counts,\"tested_samples\":tested,\"inside_samples\":inside,\"ambiguous_samples\":ambiguous,\r\n            \"max_sampled_inside_distance\":worst,\"intersecting_triangle_pairs\":cross,\"uncertain_triangle_pairs\":uncertain_cross,\r\n            \"scope\":\"Discrete poses, vertices/edge-midpoints/triangle-centroids plus non-coplanar triangle intersections; not continuous collision detection. Signed depth is undefined for invalid colliders.\"}\r\n\"\"\"Constrained face replacement: protected master patch, explicit sheet/cap policy.\r\nNo all-head distance weld. No per-face radial normal flips. No success on open edges.\r\n\"\"\"\r\nimport json\r\nimport math\r\nfrom pathlib import Path\r\nimport bpy\r\nimport bmesh\r\nfrom mathutils import Vector\r\nfrom mathutils.bvhtree import BVHTree\r\nfrom contracts import require\r\nfrom blender_common import role_objects, character_height, topology_stats, face_components, ordered_boundary_loops, consistent_outward\r\n\r\n\r\ndef polygon_area_xz(loop):\r\n    return sum(loop[i].co.x * loop[(i+1) % len(loop)].co.z - loop[(i+1) % len(loop)].co.x * loop[i].co.z for i in range(len(loop))) * .5\r\n\r\n\r\ndef ccw_chin(loop):\r\n    loop = list(loop)\r\n    if polygon_area_xz(loop) < 0:\r\n        loop.reverse()\r\n    first = min(range(len(loop)), key=lambda i: (loop[i].co.z, abs(loop[i].co.x), loop[i].index))\r\n    return loop[first:] + loop[:first]\r\n\r\n\r\ndef perimeter(loop):\r\n    return sum((loop[i].co - loop[(i+1) % len(loop)].co).length for i in range(len(loop)))\r\n\r\n\r\ndef dp_bridge(bm, patch_loop, rim_loop, skin_slot, uv_layer):\r\n    p, r = ccw_chin(patch_loop), ccw_chin(rim_loop)\r\n    n, m = len(p), len(r)\r\n    inf = float(\"inf\")\r\n    cost = [[inf] * (m+1) for _ in range(n+1)]\r\n    parent = [[None] * (m+1) for _ in range(n+1)]\r\n    cost[0][0] = 0\r\n    def triangle_cost(a, b, c):\r\n        area2 = (b.co-a.co).cross(c.co-a.co).length\r\n        if area2 < 1e-12:\r\n            return inf\r\n        lengths = [(a.co-b.co).length_squared, (a.co-c.co).length_squared, (b.co-c.co).length_squared]\r\n        quality = sum(lengths) / (2 * math.sqrt(3) * area2)\r\n        return (a.co-c.co).length + (b.co-c.co).length + 0.0001 * quality\r\n    for i in range(n+1):\r\n        for j in range(m+1):\r\n            if i:\r\n                c = cost[i-1][j] + triangle_cost(p[(i-1)%n], p[i%n], r[j%m])\r\n                if c < cost[i][j]:\r\n                    cost[i][j], parent[i][j] = c, (i-1,j,\"p\")\r\n            if j:\r\n                c = cost[i][j-1] + triangle_cost(p[i%n], r[(j-1)%m], r[j%m])\r\n                if c < cost[i][j]:\r\n                    cost[i][j], parent[i][j] = c, (i,j-1,\"r\")\r\n    require(math.isfinite(cost[n][m]), \"No nondegenerate bridge exists for selected loops\")\r\n    steps, i, j = [], n, m\r\n    while i or j:\r\n        prior = parent[i][j]\r\n        require(prior is not None, \"Invalid bridge reconstruction\")\r\n        steps.append((i,j,prior[2]))\r\n        i,j = prior[:2]\r\n    band = []\r\n    for i,j,step in reversed(steps):\r\n        verts = [p[(i-1)%n], p[i%n], r[j%m]] if step == \"p\" else [p[i%n], r[j%m], r[(j-1)%m]]\r\n        f = bm.faces.new(verts)  # Duplicate-face errors are real failures, never skipped.\r\n        f.material_index = skin_slot\r\n        for loop in f.loops:\r\n            loop[uv_layer].uv = (0.5, 0.02)\r\n        band.append(f)\r\n    require(len(band) == n+m, \"Bridge face count mismatch\")\r\n    return band\r\n\r\n\r\ndef replace_face(profile):\r\n    cfg = profile[\"face\"]\r\n    if not cfg[\"enabled\"]:\r\n        return {\"status\": \"SKIPPED\", \"reason\": \"Profile explicitly disables face reconstruction\"}\r\n    require(cfg[\"seam_mode\"] == \"direct_experimental\", \"Unqualified face seam algorithm\")\r\n    ob = role_objects(profile, \"head\")[0]\r\n    require(not ob.get(\"mujica4_face_rebuilt\"), \"Face replacement is a one-shot topology operation; restart from source, not a previous face checkpoint\")\r\n    height = character_height(profile)\r\n    patch = json.loads(Path(profile[\"_assets\"][\"master_face\"]).read_text(encoding=\"utf-8-sig\"))\r\n    require(len(patch[\"polys\"]) == patch[\"face_count\"] == len(patch[\"uvs\"]), \"Corrupt master patch\")\r\n    slots = [m.name if m else \"\" for m in ob.data.materials]\r\n    require(cfg[\"face_material\"] in slots and cfg[\"skin_material\"] in slots, \"Missing face/skin material slot\")\r\n    face_slot, skin_slot = slots.index(cfg[\"face_material\"]), slots.index(cfg[\"skin_material\"])\r\n    before = topology_stats(ob)\r\n    bm = bmesh.new()\r\n    try:\r\n        bm.from_mesh(ob.data); bm.transform(ob.matrix_world)\r\n\"\"\"EXPERIMENT: local seam refinement only; master vertices/UV never moved.\"\"\"\r\nimport bpy,bmesh,sys,json\r\nfrom pathlib import Path\r\nfrom mathutils import Vector\r\nfrom mathutils.bvhtree import BVHTree\r\nsys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))\r\nfrom blender_common import consistent_outward,save_checkpoint,topology_stats\r\nfrom geometry_probe import triangles_intersect,segment_triangle,self_intersections\r\nfrom contracts import write_json,require\r\nob=bpy.data.objects['taki_head'];bm=bmesh.new();bm.from_mesh(ob.data);bm.transform(ob.matrix_world)\r\nslot=[m.name if m else '' for m in ob.data.materials].index('Mat_Face')\r\npatchfaces=[f for f in bm.faces if f.material_index==slot];protected={v for f in patchfaces for v in f.verts};before={v:v.co.copy() for v in protected}\r\ndef soup():\r\n bm.verts.index_update();bm.faces.index_update();bm.normal_update()\r\n tris=list(bm.calc_loop_triangles());ids=[tuple(l.vert.index for l in t) for t in tris];points=[v.co.copy() for v in bm.verts]\r\n return tris,ids,points\r\nptvs=list(protected);pids={v:i for i,v in enumerate(ptvs)}\r\nptree=BVHTree.FromPolygons([v.co for v in ptvs],[tuple(pids[v] for v in f.verts) for f in patchfaces])\r\nrows=[]\r\nfor iteration in range(8):\r\n tris,ids,points=soup();tree=BVHTree.FromPolygons(points,ids,all_triangles=True)\r\n pairs=sorted({(min(a,b),max(a,b)) for a,b in tree.overlap(tree) if a!=b and not set(ids[a]).intersection(ids[b]) and triangles_intersect([points[i] for i in ids[a]],[points[i] for i in ids[b]])=='INTERSECTION'})\r\n print('ITER',iteration,'INTERSECTIONS',len(pairs),flush=True)\r\n rows.append({'iteration':iteration,'intersections':len(pairs),'vertices':len(bm.verts)})\r\n if not pairs:break\r\n edges=set()\r\n for a,b in pairs:\r\n  for t in (tris[a],tris[b]):\r\n   face=t[0].face\r\n   if face.material_index==slot:continue\r\n   for edge in face.edges:\r\n    if len(edge.link_faces)==2 and all(f.material_index!=slot for f in edge.link_faces):edges.add(edge)\r\n require(edges,'No editable seam edges')\r\n old=set(bm.verts)\r\n bmesh.ops.subdivide_edges(bm,edges=list(edges),cuts=1,use_grid_fill=True)\r\n added=set(bm.verts)-old\r\n print('SUBDIVIDE',len(edges),'ADDED',len(added),flush=True)\r\n for v in added:\r\n  orig=Vector((v.co.x,-.5,v.co.z));hit=ptree.ray_cast(orig,Vector((0,1,0)),1)\r\n  if hit[0] is not None:v.co.y=max(v.co.y,hit[0].y+.0025)\r\n  else:v.co.y+=.0025\r\n require(all(e.is_manifold for e in bm.edges),'Nonmanifold after split')\r\nelse:raise RuntimeError('Refinement failed')\r\nrequire(all((v.co-p).length<1e-8 for v,p in before.items()),'Master moved')\r\nconsistent_outward(bm);bm.transform(ob.matrix_world.inverted());bm.to_mesh(ob.data);ob.data.update();bm.free()\r\nroot=Path('4.0/runs/taki_development').resolve();path=root/'face_refined.blend'\r\nwrite_json(root/'face_refined.json',{'iterations':rows,'topology':topology_stats(ob),'checkpoint':save_checkpoint(path,root,Path('taki_stage4_rigged.blend').resolve())})\r\n","exit_code":0,"status":"completed"}}
