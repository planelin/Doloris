amic_certification_required\": true\r\n  }\r\n}\r\n    \"\"\"Traverse socket links from active outputs, not all unused data-blocks.\"\"\"\r\n    seen = set()\r\n    images = {}\r\n    def visit_socket(socket):\r\n        for link in socket.links:\r\n            visit_node(link.from_node)\r\n    def visit_node(node):\r\n        ptr = node.as_pointer()\r\n        if ptr in seen:\r\n            return\r\n        seen.add(ptr)\r\n        if node.type == \"TEX_IMAGE\" and node.image:\r\n            images[node.image.name] = node.image\r\n        if node.type == \"GROUP\" and node.node_tree:\r\n            for out in node.node_tree.nodes:\r\n                if out.type == \"GROUP_OUTPUT\" and out.is_active_output:\r\n                    for socket in out.inputs:\r\n                        visit_socket(socket)\r\n        for socket in node.inputs:\r\n            visit_socket(socket)\r\n    mats = {slot.material for o in bpy.context.scene.objects if o.type == \"MESH\" for slot in o.material_slots if slot.material}\r\n    for mat in mats:\r\n        if mat.use_nodes:\r\n            for node in mat.node_tree.nodes:\r\n                if node.type == \"OUTPUT_MATERIAL\" and node.is_active_output:\r\n                    for socket in node.inputs:\r\n                        visit_socket(socket)\r\n    return list(images.values())\r\n\r\n\r\ndef pack_reachable_images():\r\n    packed = []\r\n    for image in used_image_nodes():\r\n        require(image.source in {\"FILE\", \"GENERATED\"}, \"Unsupported animated/tiled image needs an asset adapter: \" + image.name)\r\n        require(image.size[0] > 0 and image.size[1] > 0, \"Missing render-reachable image: \" + image.name)\r\n        if not image.packed_file:\r\n            image.pack()\r\n        packed.append(image.name)\r\n    return sorted(packed)\r\n\r\n\r\ndef save_checkpoint(path, run_root, source_path):\r\n    output = confined_path(run_root, path)\r\n    source_path = Path(source_path).resolve()\r\n    require(output != source_path and output.suffix.lower() == \".blend\", \"Refusing to overwrite input or save non-blend\")\r\n    require(not output.exists(), \"Checkpoint already exists; use a fresh run directory\")\r\n    output.parent.mkdir(parents=True, exist_ok=True)\r\n    packed = pack_reachable_images()\r\n    bpy.context.preferences.filepaths.save_version = 0\r\n    bpy.ops.wm.save_as_mainfile(filepath=str(output), check_existing=False)\r\n    require(output.is_file() and output.stat().st_size > 1024, \"Checkpoint missing after save\")\r\n    return {\"path\": str(output), \"sha256\": sha256_file(output), \"packed_images\": packed}\r\n\r\n\r\n@contextlib.contextmanager\r\ndef exclude_modifiers(objects, names):\r\n    saved = [(m, m.show_viewport, m.show_render) for ob in objects for m in ob.modifiers if m.name in names]\r\n    try:\r\n        for m, _, _ in saved:\r\n            m.show_viewport = False\r\n            m.show_render = False\r\n        bpy.context.view_layer.update()\r\n        yield\r\n    finally:\r\n        for m, viewport, render in saved:\r\n            m.show_viewport = viewport\r\n            m.show_render = render\r\n        bpy.context.view_layer.update()\r\n    return {\"nonadjacent_triangle_intersections\":len(hits),\"uncertain_pairs\":len(uncertain),\"intersections\":hits[:40],\"uncertain\":uncertain[:40],\"bvh_candidates\":len(pairs)}\r\n\r\n\r\ndef probe_collision(cloth_surface,collider_surface,tolerance,check_self=True):\r\n    cv,ct,ce=cloth_surface;lv,lt,le=collider_surface\r\n    contract=collider_contract(lv,lt)\r\n    valid=all(value==0 for value in contract.values())\r\n    selfcheck=self_intersections(lv,lt) if valid and check_self else None\r\n    if selfcheck and (selfcheck[\"nonadjacent_triangle_intersections\"] or selfcheck[\"uncertain_pairs\"]):valid=False\r\n    # Pair intersections remain useful evidence even if inside/outside is undefined.\r\n    ltree=BVHTree.FromPolygons(lv,lt,all_triangles=True)\r\n    ctree=BVHTree.FromPolygons(cv,ct,all_triangles=True)\r\n    overlap=ctree.overlap(ltree)\r\n    cross=0;uncertain_cross=0\r\n    for ci,li in overlap:\r\n        state=triangles_intersect([cv[i] for i in ct[ci]],[lv[i] for i in lt[li]])\r\n        cross+=state==\"INTERSECTION\"\r\n        uncertain_cross+=state in {\"COPLANAR_CANDIDATE\",\"DEGENERATE\"}\r\n    counts={kind:{state:0 for state in (\"INSIDE\",\"OUTSIDE\",\"CONTACT\",\"AMBIGUOUS\")} for kind in (\"vertex\",\"edge_midpoint\",\"triangle_centroid\")}\r\n    worst=0.0;tested=0\r\n    if valid:\r\n        bounds=aabb(lv)\r\n        for kind,point in samples(cv,ct,ce):\r\n            state,distance,_=point_state(ltree,point,bounds,tolerance)\r\n            counts[kind][state]+=1;tested+=1\r\n            if state==\"INSIDE\":worst=max(worst,distance or 0)\r\n    inside=sum(row[\"INSIDE\"] for row in counts.values());ambiguous=sum(row[\"AMBIGUOUS\"] for row in counts.values())\r\n    status=\"INVALID_COLLIDER\" if not valid else \"PENETRATING\" if inside or cross else \"INCONCLUSIVE\" if ambiguous or uncertain_cross else \"SAMPLED_CLEAR\"\r\n    return {\"status\":status,\"collider_contract\":contract,\"collider_self_intersections\":selfcheck,\"samples\":counts,\"tested_samples\":tested,\"inside_samples\":inside,\"ambiguous_samples\":ambiguous,\r\n            \"max_sampled_inside_distance\":worst,\"intersecting_triangle_pairs\":cross,\"uncertain_triangle_pairs\":uncertain_cross,\r\n            \"scope\":\"Discrete poses, vertices/edge-midpoints/triangle-centroids plus non-coplanar triangle intersections; not continuous collision detection. Signed depth is undefined for invalid colliders.\"}\r\n","exit_code":0,"status":"completed"}}
