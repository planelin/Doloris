{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\scripts\\\\stage.py' -Encoding UTF8; Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\scripts\\\\verify_asset.py' -Encoding UTF8; Get-ChildItem -File -Path 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\runs\\\\taki_baseline\\\\renders','C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\runs\\\\taki_development\\\\face_renders' | Select-Object DirectoryName,Name,Length | Format-Table -AutoSize | Out-String -Width 200\"","aggregated_output":"\"\"\"One Blender stage per process. JSON status is authoritative; failures are nonzero.\"\"\"\r\nimport argparse\r\nimport json\r\nfrom pathlib import Path\r\nimport sys\r\nimport time\r\nimport traceback\r\n\r\nsys.path.insert(0, str(Path(__file__).resolve().parent))\r\nimport bpy\r\nfrom contracts import load_profile, write_json, require, sha256_file, stable_hash, VERSION\r\nfrom blender_common import validate_scene, save_checkpoint\r\nfrom repair_foundation import cleanup, repair_weights\r\nfrom repair_face import replace_face\r\n\r\n\r\ndef run():\r\n    ap=argparse.ArgumentParser()\r\n    ap.add_argument(\"--profile\",required=True)\r\n    ap.add_argument(\"--stage\",choices=[\"preflight\",\"cleanup\",\"face\",\"weights\",\"expressions\",\"verify\"],required=True)\r\n    ap.add_argument(\"--run-root\",required=True)\r\n    ap.add_argument(\"--report\",required=True)\r\n    ap.add_argument(\"--output\")\r\n    args=ap.parse_args(sys.argv[sys.argv.index(\"--\")+1:])\r\n    profile=load_profile(args.profile)\r\n    report={\"pipeline_version\":VERSION,\"stage\":args.stage,\"status\":\"RUNNING\",\"input\":bpy.data.filepath,\"input_sha256\":sha256_file(bpy.data.filepath),\"profile_sha256\":sha256_file(args.profile),\"blender\":bpy.app.version_string}\r\n    start=time.perf_counter()\r\n    try:\r\n        validate_scene(profile)\r\n        if args.stage==\"preflight\":\r\n            from inspect_scene import inspect\r\n            result={\"scene_contract\":validate_scene(profile),\"inventory\":inspect()}\r\n        elif args.stage==\"cleanup\":result=cleanup(profile)\r\n        elif args.stage==\"face\":result=replace_face(profile)\r\n        elif args.stage==\"weights\":result=repair_weights(profile)\r\n        elif args.stage==\"expressions\":\r\n            from expressions import build_expressions\r\n            result=build_expressions(profile)\r\n        else:\r\n            from verify_asset import verify_asset\r\n            result=verify_asset(profile)\r\n        report[\"result\"]=result\r\n        if args.output:\r\n            report[\"checkpoint\"]=save_checkpoint(args.output,args.run_root,profile[\"_input_path\"])\r\n        report[\"status\"]=\"PASS\"\r\n    except Exception as exc:\r\n        report[\"status\"]=\"FAIL\"\r\n        report[\"error\"]={\"type\":type(exc).__name__,\"message\":str(exc),\"traceback\":traceback.format_exc()}\r\n        raise\r\n    finally:\r\n        report[\"duration_seconds\"]=round(time.perf_counter()-start,4)\r\n        write_json(args.report,report)\r\n        print(\"[MUJICA_STAGE]\",args.stage,report[\"status\"],args.report,flush=True)\r\n\r\n\r\nif __name__==\"__main__\":run()\r\n\"\"\"Fresh-process asset verification. Static readiness is separate from release approval.\"\"\"\r\nimport bpy\r\nimport bmesh\r\nfrom mathutils import Vector\r\nfrom contracts import require\r\nfrom blender_common import role_objects,topology_stats,used_image_nodes,exclude_modifiers,character_height,mesh_fingerprint,weight_fingerprint\r\nfrom repair_foundation import audit_weights\r\nfrom expressions import verify_expressions\r\nfrom geometry_probe import evaluated_surface,self_intersections,probe_collision\r\n\r\n\r\ndef verify_asset(profile):\r\n    topologies={o.name:topology_stats(o) for 