ic',lambda: equal(c.normalize_weights({'b':1,'a':1,'c':1},2),{'a':.5,'b':.5}))\ncheck('bool_influence_limit_rejected',lambda: rejected(lambda:c.normalize_weights({'a':1},True)))\ncheck('negative_weight_epsilon_rejected',lambda: rejected(lambda:c.normalize_weights({'a':1},epsilon=-1)))\ndef overflow():\n    w=c.normalize_weights({'a':1e308,'b':1e308})\n    assert all(math.isfinite(x) for x in w.values()) and abs(sum(w.values())-1)<1e-9, w\ncheck('finite_weight_sum_overflow_handled',overflow)\ncheck('path_child_accepted',lambda:equal(c.confined_path(root/'runs',root/'runs'/'new'/'asset.blend'),(root/'runs'/'new'/'asset.blend').resolve()))\ncheck('path_parent_rejected',lambda:rejected(lambda:c.confined_path(root/'runs',root/'scripts'/'stage.py')))\ncheck('path_root_itself_rejected',lambda:rejected(lambda:c.confined_path(root/'runs',root/'runs')))\ncheck('sibling_prefix_rejected',lambda:rejected(lambda:c.confined_path(root/'runs',root/'runs-other'/'asset.blend')))\ncheck('hash_key_order_stable',lambda:equal(c.stable_hash({'a':1,'b':2}),c.stable_hash({'b':2,'a':1})))\ncheck('hash_nan_rejected',lambda:rejected(lambda:c.stable_hash({'x':float('nan')})))\ncheck('release_structural_fail_rejected',lambda:equal(c.classify_release(False,'PASS',True,True),'REJECTED'))\ncheck('release_dynamic_missing_candidate',lambda:equal(c.classify_release(True,'NOT_TESTED',True,True),'EXPERIMENTAL_CANDIDATE'))\ncheck('release_visual_missing_candidate',lambda:equal(c.classify_release(True,'PASS',False,True),'EXPERIMENTAL_CANDIDATE'))\ncheck('release_never_auto_approved',lambda:equal(c.classify_release(True,'PASS',True,True),'RELEASE_REVIEW_REQUIRED'))\nbase=json.loads((root/'profiles/taki.json').read_text(encoding='utf-8-sig'))\ndef profile_test(name,mutate):\n    p=copy.deepcopy(base);mutate(p)\n    with patch.object(Path,'read_text',return_value=json.dumps(p)):\n        check(name,lambda:rejected(lambda:c.load_profile(root/'profiles'/'in-memory-test.json')))\ncheck('real_profile_loads',lambd