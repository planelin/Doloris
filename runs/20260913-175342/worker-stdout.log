{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\scripts\\\\contracts.py' -Encoding UTF8; Get-Content -LiteralPath 'C:\\\\Agents\\\\codex\\\\mujica4_test\\\\4.0\\\\runs\\\\taki_restore_check\\\\face.json' -Encoding UTF8\"","aggregated_output":"\"\"\"Standard-library contracts shared by the launcher, Blender stages and tests.\"\"\"\r\nfrom __future__ import annotations\r\nimport hashlib\r\nimport json\r\nimport math\r\nfrom pathlib import Path\r\n\r\nVERSION = \"4.0.0-experimental\"\r\nROLES = {\"head\", \"torso\", \"legs\", \"hands\", \"shoes\", \"hair\", \"skirt\"}\r\n\r\n\r\nclass GateError(RuntimeError):\r\n    \"\"\"An explicit failed pipeline contract, never a success-with-warning.\"\"\"\r\n\r\n\r\ndef require(condition, message):\r\n    if not condition:\r\n        raise GateError(message)\r\n\r\n\r\ndef sha256_file(path):\r\n    h = hashlib.sha256()\r\n    with Path(path).open(\"rb\") as f:\r\n        for block in iter(lambda: f.read(1 << 20), b\"\"):\r\n            h.update(block)\r\n    return h.hexdigest()\r\n\r\n\r\ndef stable_hash(data):\r\n    return hashlib.sha256(json.dumps(data, sort_keys=True, ensure_ascii=False, allow_nan=False, separators=(\",\", \":\")).encode(\"utf-8\")).hexdigest()\r\n\r\n\r\ndef write_json(path, data):\r\n    path = Path(path)\r\n    path.parent.mkdir(parents=True, exist_ok=True)\r\n    tmp = path.with_suffix(path.suffix + \".tmp\")\r\n    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2, allow_nan=False) + \"\\n\", encoding=\"utf-8\")\r\n    tmp.replace(path)\r\n\r\n\r\ndef confined_path(root, candidate):\r\n    root, candidate = Path(root).resolve(), Path(candidate).resolve()\r\n    require(candidate != root and candidate.is_relative_to(root), f\"Output must be a child of run directory: {candidate}\")\r\n    return candidate\r\n\r\n\r\ndef frame_samples(start, end, step=1):\r\n    require(isinstance(step, int) and not isinstance(step, bool) and step > 0, \"Frame step must be a positive integer\")\r\n    require(isinstance(start, int) and isinstance(end, int) and end >= start, \"Invalid frame range\")\r\n    frames = list(range(start, end + 1, step))\r\n    if frames[-1] != end:\r\n        frames.append(end)\r\n    return frames\r\n\r\n\r\ndef normalize_weights(weights, limit=4, epsilon=1e-6):\r\n    require(isinstance(limit, int) and limit >= 1, \"Influence limit must be positive\")\r\n    require(all(math.isfinite(w) and w >= 0 for w in weights.values()), \"Invalid/negative/non-finite weights\")\r\n    items = sorted(((n, w) for n, w in weights.items() if w > epsilon), key=lambda x: (-x[1], x[0]))[:limit]\r\n    total = sum(w for _, w in items)\r\n    require(total > epsilon, \"No valid weight support; do not silently guess a bone\")\r\n    return {n: w / total for n, w in items}\r\n\r\n\r\ndef load_profile(path):\r\n    path = Path(path).resolve()\r\n    p = json.loads(path.read_text(encoding=\"utf-8-sig\"))\r\n    require(p.get(\"schema_version\") == 1, \"Unsupported profile schema\")\r\n    require(isinstance(p.get(\"character\"), str) and p[\"character\"], \"Character must be named\")\r\n    require(p.get(\"rig\"), \"Explicit rig object is required\")\r\n    require(p.get(\"bone_prefix\") is not None, \"Explicit bone prefix is required (may be empty)\")\r\n    require(p.get(\"coordinate_contract\", {}).get(\"up\") == \"+Z\" and p[\"coordinate_contract\"].get(\"front\") == \"-Y\", \"This version supports Z-up, -Y-front only; convert deliberately before running\")\r\n    parts = p.get(\"parts\", {})\r\n    require(set(parts) == ROLES, f\"All role keys must be declared, including empty branches: {sorted(ROLES)}\")\r\n    names = []\r\n    for role, objects in parts.items():\r\n        require(isinstance(objects, list) and all(isinstance(n, str) and n for n in objects), f\"Inval