n    title: '判据：',\n    text: '退避的目标不是\"再试一次\"，而是让失败收敛成两种结局之一：恢复，或者明确地放弃。停在中间不算结果。',\n    danger: false\n  },\n  spec: [\n    ['起始间隔', '<code>15s</code>'],\n    ['退避上限', '<code>120s</code>（cap）'],\n    ['最大次数', '<code>5</code>'],\n    ['抖动系数', '<code>0.5 + rand × 0.5</code>'],\n    ['触发条件', '429 / 5xx / 超时'],\n    ['升级动作', '熔断 + 端点轮换']\n  ],\n  related: [\n    ['01', '心跳检测', '01-heartbeat.html'],\n    ['04', '供应商轮换', '04-rotation.html'],\n    ['12', '终态报告', '12-report.html']\n  ],\n  prev: ['01 心跳检测', '01-heartbeat.html'],\n  next: ['03 会话接管', '03-takeover.html']\n};\n\nnodeRepl.write(writePage(p02));\n","title":"Write page 02 backoff"},"result":{"content":[{"type":"text","text":"02-backoff.html bytes=9075"}],"_meta":{"codex/nodeReplExecutionDurationMs":3},"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p03 = {\n  id: '03', name: '会话接管', en: 'Session Takeover', file: '03-takeover.html',\n  progressLine: 'testproj/pages/03-takeover.html 会话接管',\n  status: 'online', statusLabel: '在线',\n  lead: '原会话中断后最容易犯的错，是\"再开一个进程接着干\"：两个写入者同时改同一批文件，产出的不是进度而是互相覆盖。会话接管只解决一件事——由谁接着干，且任何时刻只有一个写入者。',\n  meta: [['当前状态', '在线运行'], ['接管闸门', '单写者锁'], ['静默判定', '≥ 15 秒']],\n  diagram: {\n    title: '接管决策链',\n    rows: [\n      ['心跳击穿 → 判定原会话失联', '信号', ''],\n      ['检查单写者锁 / 会话是否仍被界面占用', '闸门', ''],\n      ['锁被持有 → 耐心重试并提示关闭原会话', '等待', 'warn'],\n      ['锁释放 → 发出续跑指令（带接管说明）', '接管', ''],\n      ['续跑者续写心跳与干预存档', '续跑', 'standby']\n    ]\n  },\n  what: [\n    '接管的前提是\"原写入者确实停了\"，而不是\"看起来没动静\"。文件静默 15 秒只是弱信号：模型长时间生成时恰好不落盘，在文件系统看来同样安静。真正可靠的闸门是单写者锁。',\n    '界面还开着时，接管会被直接拒绝（<code>SESSION_BUSY</code>）。正确处置是耐心重试，并把话说清楚：请停止或关闭原会话。为了\"先跑起来\"而绕过锁，是数据损坏的最短路径。',\n    '接管者必须知道两件事：自己是谁（接管的续跑者），以及不要重做已完成的部分。续跑的第一步永远是读清单，而不是从第一项重新写一遍。',\n    '续跑也要有预算。同一阶段连续接管多次仍失败，说明问题不在\"谁来跑\"，而在\"这件事本身跑不通\"，此时应停止自动接管，升级为明确的失败终态。'\n  ],\n  signals: [\n    ['原会话静默 ≥ 15 秒', '弱信号：只用于决定接管顺序，不足以单独触发接管'],\n    ['单写者锁仍被持有', '拒绝接管：原界面还开着，等待并提示关闭会话'],\n    ['锁已释放且心跳击穿', '允许接管：闸门与信号同时满足'],\n    ['接管后心跳恢复写入', '接管成功，回到常规观测'],\n    ['同一阶段连续接管 ≥ 3 次', '停止自动恢复，转人工介入并输出失败终态']\n  ],\n  steps: [\n    '三信号交叉判定：单写者锁已释放 + 心跳击穿 + 文件静默，三者同时满足才认为原会话真的停了。',\n    '锁被持有时输出会话忙提示并退避重试，这部分等待不计入续跑预算，避免把\"人在用\"误算成\"系统故障\"。',\n    '闸门打开后发出续跑指令，并在指令里明确\"读取历史、确认未完成项、不要重做已完成部分\"。',\n    '要求接管者维护进度清单：剩余工作逐条列出，完成一项立即勾选，勾完才允许停止。',\n    '接管者续写自己的心跳与干预存档，保持时间线连续，让终态报告能还原\"谁在什么时候接手\"。',\n    '记录接管次数；同一阶段达到上限即熔断，不再自动恢复，交给人处理。'\n  ],\n  failure: [\n    '锁还开着就强行接管：两个写入者同时改同一批文件，后写者覆盖前写者，丢失的工作再也找不回来。',\n    '把\"文件静默\"当成\"会话已停\"：在模型长推理期间误接管，制造出人为的双写者。',\n    '接管者从头重跑：已完成的工作被重复执行，写文件、提交这类操作可能被重复施加。',\n    '无上限接管：崩溃循环被无限放大，每次接管都消耗额度却没有推进，最终连日志都被冲掉。'\n  ],\n  callout: {\n    title: '红线：',\n    text: '任何时候都不要为了\"让它继续跑\"而绕过单写者锁。宁可等一会儿，也不要出现两个写入者。',\n    danger: true\n  },\n  spec: [\n    ['静默阈值', '≥ <code>15s</code>'],\n    ['忙重试间隔', '<code>20s</code>（不占续跑预算）'],\n    ['闸门', 'codex 单写者会话锁'],\n    ['接管上限', '同阶段 <code>3</code> 次'],\n    ['续跑入口', '<code>codex exec resume</code>'],\n    ['心跳基线', '会话 rollout 文件']\n  ],\n  related: [\n    ['01', '心跳检测', '01-heartbeat.html'],\n    ['02', '指数退避', '02-backoff.html'],\n    ['10', '混沌测试', '10-chaos.html']\n  ],\n  prev: ['02 指数退避', '02-backoff.html'],\n  next: ['04 供应商轮换', '04-rotation.html']\n};\n\nnodeRepl.write(writePage(p03));\n","title":"Write page 03 takeover"},"result":null,"error":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_42","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p03 = {\n  id: '03', name: '会话接管', en: 'Session Takeover', file: '03-takeover.html',\n  progressLine: 'testproj/pages/03-takeover.html 会话接管',\n  status: 'online', statusLabel: '在线',\n  lead: '原会话中断后最容易犯的错，是\"再开一个进程接着干\"：两个写入者同时改同一批文件，产出的不是进度而是互相覆盖。会话接管只解决一件事——由谁接着干，且任何时刻只有一个写入者。',\n  meta: [['当前状态', '在线运行'], ['接管闸门', '单写者锁'], ['静默判定', '≥ 15 秒']],\n  diagram: {\n    title: '接管决策链',\n    rows: [\n      ['心跳击穿 → 判定原会话失联', '信号', ''],\n      ['检查单写者锁 / 会话是否仍被界面占用', '闸门', ''],\n      ['锁被持有 → 耐心重试并提示关闭原会话', '等待', 'warn'],\n      ['锁释放 → 发出续跑指令（带接管说明）', '接管', ''],\n      ['续跑者续写心跳与干预存档', '续跑', 'standby']\n    ]\n  },\n  what: [\n    '接管的前提是\"原写入者确实停了\"，而不是\"看起来没动静\"。文件静默 15 秒只是弱信号：模型长时间生成时恰好不落盘，在文件系统看来同样安静。真正可靠的闸门是单写者锁。',\n    '界面还开着时，接管会被直接拒绝（<code>SESSION_BUSY</code>）。正确处置是耐心重试，并把话说清楚：请停止或关闭原会话。为了\"先跑起来\"而绕过锁，是数据损坏的最短路径。',\n    '接管者必须知道两件事：自己是谁（接管的续跑者），以及不要重做已完成的部分。续跑的第一步永远是读清单，而不是从第一项重新写一遍。',\n    '续跑也要有预算。同一阶段连续接管多次仍失败，说明问题不在\"谁来跑\"，而在\"这件事本身跑不通\"，此时应停止自动接管，升级为明确的失败终态。'\n  ],\n  signals: [\n    ['原会话静默 ≥ 15 秒', '弱信号：只用于决定接管顺序，不足以单独触发接管'],\n    ['单写者锁仍被持有', '拒绝接管：原界面还开着，等待并提示关闭会话'],\n    ['锁已释放且心跳击穿', '允许接管：闸门与信号同时满足'],\n    ['接管后心跳恢复写入', '接管成功，回到常规观测'],\n    ['同一阶段连续接管 ≥ 3 次', '停止自动恢复，转人工介入并输出失败终态']\n  ],\n  steps: [\n    '三信号交叉判定：单写者锁已释放 + 心跳击穿 + 文件静默，三者同时满足才认为原会话真的停了。',\n    '锁被持有时输出会话忙提示并退避重试，这部分等待不计入续跑预算，避免把\"人在用\"误算成\"系统故障\"。',\n    '闸门打开后发出续跑指令，并在指令里明确\"读取历史、确认未完成项、不要重做已完成部分\"。',\n    '要求接管者维护进度清单：剩余工作逐条列出，完成一项立即勾选，勾完才允许停止。',\n    '接管者续写自己的心跳与干预存档，保持时间线连续，让终态报告能还原\"谁在什么时候接手\"。',\n    '记录接管次数；同一阶段达到上限即熔断，不再自动恢复，交给人处理。'\n  ],\n  failure: [\n    '锁还开着就强行接管：两个写入者同时改同一批文件，后写者覆盖前写者，丢失的工作再也找不回来。',\n    '把\"文件静默\"当成\"会话已停\"：在模型长推理期间误接管，制造出人为的双写者。',\n    '接管者从头重跑：已完成的工作被重复执行，写文件、提交这类操作可能被重复施加。',\n    '无上限接管：崩溃循环被无限放大，每次接管都消耗额度却没有推进，最终连日志都被冲掉。'\n  ],\n  callout: {\n    title: '红线：',\n    text: '任何时候都不要为了\"让它继续跑\"而绕过单写者锁。宁可等一会儿，也不要出现两个写入者。',\n    danger: true\n  },\n  spec: [\n    ['静默阈值', '≥ <code>15s</code>'],\n    ['忙重试间隔', '<code>20s</code>（不占续跑预算）'],\n    ['闸门', 'codex 单写者会话锁'],\n    ['接管上限', '同阶段 <code>3</code> 次'],\n    ['续跑入口', '<code>codex exec resume</code>'],\n    ['心跳基线', '会话 rollout 文件']\n  ],\n  related: [\n    ['01', '心跳检测', '01-heartbeat.html'],\n    ['02', '指数退避', '02-backoff.html'],\n    ['10', '混沌测试', '10-chaos.html']\n  ],\n  prev: ['02 指数退避', '02-backoff.html'],\n  next: ['04 供应商轮换', '04-rotation.html']\n};\n\nnodeRepl.write(writePage(p03));\n","title":"Write page 03 takeover"},"result":{"content":[{"type":"text","text":"03-takeover.html bytes=9213"}],"_meta":{"codex/nodeReplExecutionDurationMs":2},"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p04 = {\n  id: '04', name: '供应商轮换', en: 'Provider Rotation', file: '04-rotation.html',\n  progressLine: 'testproj/pages/04-rotation.html 供应商轮换',\n  status: 'watch', statusLabel: '观察',\n  lead: '再耐心的重试也救不回一个已经死掉的端点。供应商轮换解决的是\"这条链路不通了，换一条继续跑\"，同时确保故障不会从上游被搬到了下游。',\n  meta: [['当前状态', '观察中'], ['切换阈值', '同端点连续 2 次失败'], ['冷却粒度', '按 key / 按端点']],\n  diagram: {\n    title: '轮换判定路径',\n    rows: [\n      ['同一端点连续失败计数 +1', '计数', ''],\n      ['达到阈值 → 当前端点标记为冷却', '冷却', 'warn'],\n      ['按优先级挑选下一个可用端点', '切换', ''],\n      ['对新端点发一次最小请求试活', '试活', ''],\n      ['成功 → 继续任务并复位失败计数', '恢复', 'standby'],\n      ['全部端点不可用 → 输出失败终态', '终局', 'warn']\n    ]\n  },\n  what: [\n    '判据必须是\"连续失败\"而不是单次失败。个别 5xx 和网络抖动在任何链路上都会出现，单次失败就轮换会让所有端点都被短暂地判死，最后无端点可用。',\n    '冷却要有粒度：出问题的是某个 key 或某个端点，不是整个供应商。把粒度做细，一次限流才不会让整个池子同时下线。',\n    '轮换改变的是链路，不是任务语义。切换后要么让会话能续上（同一上下文继续），要么明确重跑当前步骤；含混地\"接着跑\"会产出前后矛盾的结果。',\n    '全部端点都不可用时要快速失败。慢慢试完整个池子只会耗尽时间预算，最后连一份像样的失败报告都留不下。'\n  ],\n  signals: [\n    ['单次 5xx 或超时', '只退避重试，不触发轮换'],\n    ['同一端点连续 2 次失败', '判定该端点不可用，标记冷却并轮换'],\n    ['返回 401 / 403 / 额度耗尽', '立即轮换，不做退避（退避不会让凭据或余额恢复）'],\n    ['新端点首个请求成功', '计为健康，恢复常规重试节奏'],\n    ['所有端点均不可用', '快速失败：停止轮换，输出失败终态与端点健康快照']\n  ],\n  steps: [\n    '为每个端点维护独立的失败计数与冷却时间，避免一个端点的故障污染其它端点的判定。',\n    '达到连续失败阈值后，把当前端点标记为冷却，并按优先级选择下一个可用端点。',\n    '切换后先发一次最小请求试活，确认新端点真的可用再恢复正式任务，避免把长任务压在一个坏端点上。',\n    '恢复执行时明确当前步骤的起点：能续上下文就续，不能续就显式重跑该步骤，禁止含混接续。',\n    '每次轮换写入干预存档：旧端点、新端点、触发原因、切换时刻。',\n    '池子耗尽即停止，输出终态失败与端点健康快照，供人判断是凭据、额度还是网络的问题。'\n  ],\n  failure: [\n    '单次失败就轮换：所有端点轮流被短暂判死，任务在端点之间来回弹跳，永远跑不完一个完整步骤。',\n    '切换前不试活：长任务被压在一个同样坏的端点上，故障被重复发现一次。',\n    '冷却没有期限：端点恢复后仍被跳过，可用容量被白白浪费。',\n    '切换后重放有副作用的操作：换的是链路，被重复执行的是写文件和提交动作。'\n  ],\n  callout: {\n    title: '原则：',\n    text: '轮换是\"换链路\"，不是\"改任务\"。任务语义保持不变，轮换才会收敛；语义一变，所有端点都会以不同方式失败。',\n    danger: false\n  },\n  spec: [\n    ['切换阈值', '同端点连续 <code>2</code> 次失败'],\n    ['冷却粒度', '按 key / 按端点'],\n    ['试活请求', '<code>1</code> 次最小请求'],\n    ['立即轮换', '401 / 403 / 额度耗尽'],\n    ['池子耗尽', '快速失败 + 健康快照'],\n    ['留痕', '<code>interventions.jsonl</code>']\n  ],\n  related: [\n    ['02', '指数退避', '02-backoff.html'],\n    ['05', '端点探针', '05-probe.html'],\n    ['06', '出站代理', '06-egress.html']\n  ],\n  prev: ['03 会话接管', '03-takeover.html'],\n  next: ['05 端点探针', '05-probe.html']\n};\n\nnodeRepl.write(writePage(p04));\n","title":"Write page 04 provider rotation"},"result":null,"error":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p04 = {\n  id: '04', name: '供应商轮换', en: 'Provider Rotation', file: '04-rotation.html',\n  progressLine: 'testproj/pages/04-rotation.html 供应商轮换',\n  status: 'watch', statusLabel: '观察',\n  lead: '再耐心的重试也救不回一个已经死掉的端点。供应商轮换解决的是\"这条链路不通了，换一条继续跑\"，同时确保故障不会从上游被搬到了下游。',\n  meta: [['当前状态', '观察中'], ['切换阈值', '同端点连续 2 次失败'], ['冷却粒度', '按 key / 按端点']],\n  diagram: {\n    title: '轮换判定路径',\n    rows: [\n      ['同一端点连续失败计数 +1', '计数', ''],\n      ['达到阈值 → 当前端点标记为冷却', '冷却', 'warn'],\n      ['按优先级挑选下一个可用端点', '切换', ''],\n      ['对新端点发一次最小请求试活', '试活', ''],\n      ['成功 → 继续任务并复位失败计数', '恢复', 'standby'],\n      ['全部端点不可用 → 输出失败终态', '终局', 'warn']\n    ]\n  },\n  what: [\n    '判据必须是\"连续失败\"而不是单次失败。个别 5xx 和网络抖动在任何链路上都会出现，单次失败就轮换会让所有端点都被短暂地判死，最后无端点可用。',\n    '冷却要有粒度：出问题的是某个 key 或某个端点，不是整个供应商。把粒度做细，一次限流才不会让整个池子同时下线。',\n    '轮换改变的是链路，不是任务语义。切换后要么让会话能续上（同一上下文继续），要么明确重跑当前步骤；含混地\"接着跑\"会产出前后矛盾的结果。',\n    '全部端点都不可用时要快速失败。慢慢试完整个池子只会耗尽时间预算，最后连一份像样的失败报告都留不下。'\n  ],\n  signals: [\n    ['单次 5xx 或超时', '只退避重试，不触发轮换'],\n    ['同一端点连续 2 次失败', '判定该端点不可用，标记冷却并轮换'],\n    ['返回 401 / 403 / 额度耗尽', '立即轮换，不做退避（退避不会让凭据或余额恢复）'],\n    ['新端点首个请求成功', '计为健康，恢复常规重试节奏'],\n    ['所有端点均不可用', '快速失败：停止轮换，输出失败终态与端点健康快照']\n  ],\n  steps: [\n    '为每个端点维护独立的失败计数与冷却时间，避免一个端点的故障污染其它端点的判定。',\n    '达到连续失败阈值后，把当前端点标记为冷却，并按优先级选择下一个可用端点。',\n    '切换后先发一次最小请求试活，确认新端点真的可用再恢复正式任务，避免把长任务压在一个坏端点上。',\n    '恢复执行时明确当前步骤的起点：能续上下文就续，不能续就显式重跑该步骤，禁止含混接续。',\n    '每次轮换写入干预存档：旧端点、新端点、触发原因、切换时刻。',\n    '池子耗尽即停止，输出终态失败与端点健康快照，供人判断是凭据、额度还是网络的问题。'\n  ],\n  failure: [\n    '单次失败就轮换：所有端点轮流被短暂判死，任务在端点之间来回弹跳，永远跑不完一个完整步骤。',\n    '切换前不试活：长任务被压在一个同样坏的端点上，故障被重复发现一次。',\n    '冷却没有期限：端点恢复后仍被跳过，可用容量被白白浪费。',\n    '切换后重放有副作用的操作：换的是链路，被重复执行的是写文件和提交动作。'\n  ],\n  callout: {\n    title: '原则：',\n    text: '轮换是\"换链路\"，不是\"改任务\"。任务语义保持不变，轮换才会收敛；语义一变，所有端点都会以不同方式失败。',\n    danger: false\n  },\n  spec: [\n    ['切换阈值', '同端点连续 <code>2</code> 次失败'],\n    ['冷却粒度', '按 key / 按端点'],\n    ['试活请求', '<code>1</code> 次最小请求'],\n    ['立即轮换', '401 / 403 / 额度耗尽'],\n    ['池子耗尽', '快速失败 + 健康快照'],\n    ['留痕', '<code>interventions.jsonl</code>']\n  ],\n  related: [\n    ['02', '指数退避', '02-backoff.html'],\n    ['05', '端点探针', '05-probe.html'],\n    ['06', '出站代理', '06-egress.html']\n  ],\n  prev: ['03 会话接管', '03-takeover.html'],\n  next: ['05 端点探针', '05-probe.html']\n};\n\nnodeRepl.write(writePage(p04));\n","title":"Write page 04 provider rotation"},"result":{"content":[{"type":"text","text":"04-rotation.html bytes=9115"}],"_meta":{"codex/nodeReplExecutionDurationMs":1},"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.started","item":{"id":"item_44","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p05 = {\n  id: '05', name: '端点探针', en: 'Endpoint Probe', file: '05-probe.html',\n  progressLine: 'testproj/pages/05-probe.html 端点探针',\n  status: 'online', statusLabel: '在线',\n  lead: '把故障留在长任务开始之前，是探针存在的全部理由。一次最小请求的代价，远小于跑了两小时才发现凭据早就失效、或者出站链路根本不通。',\n  meta: [['当前状态', '在线运行'], ['探针规模', '1 次最小调用'], ['探针时机', '启动前 + 切换后']],\n  diagram: {\n    title: '开跑前的探针流程',\n    rows: [\n      ['任务启动，进入探针阶段而非直接开跑', '入口', ''],\n      ['对每个候选端点发出一次最小请求', '试活', ''],\n      ['校验状态码、content-type 与响应可解析性', '判定', ''],\n      ['不可用端点被剔除出池并记录原因', '筛选', 'warn'],\n      ['全部端点不可用 → 任务根本不启动', '熔断', 'warn'],\n      ['通过 → 放行长任务并写入健康快照', '放行', 'standby']\n    ]\n  },\n  what: [\n    '探针要便宜、要能解析、要能区分失败类型。一个只判断\"连接是否建立\"的探针会把 401、429 和 200 一视同仁，等于没探。',\n    '探针的意义是 fail fast：在长任务开始之前把配置错、凭据错、代理不通这三类问题挡下来。跑了一半才暴露的故障，代价是已完成的工作和额度。',\n    '探针本身必须有超时。黑洞端点不会返回错误，它什么都不返回——没有超时的探针会把启动过程一起拖住。',\n    '探针结果要落盘成健康快照，让\"端点是否可用\"从传闻变成实测数据；后续轮换的决策也应当读这份快照。'\n  ],\n  signals: [\n    ['返回 200 且响应体可解析', '端点可用，放行长任务'],\n    ['返回 401 / 403', '凭据问题：剔除该端点并明确标注为认证失败，而不是网络故障'],\n    ['返回 429', '端点可达但正被限流：标记冷却，视配额决定是否仍入池'],\n    ['探针超时或连接被拒绝', '端点不可达：剔除，并交由出站代理机制排查链路'],\n    ['全部端点探针失败', '任务不启动，直接输出失败终态与健康快照']\n  ],\n  steps: [\n    '在任务入口处强制插入探针阶段：任何长任务都不得跳过探针直接开跑。',\n    '对池中每个端点发一次最小请求（一条 ping 级别的调用），并设置独立超时（如 10 秒）。',\n    '解析响应时同时看状态码、content-type 和响应体能否被解析，避免把网关返回的 HTML 错误页当成成功。',\n    '把不可用端点连同原因一起剔出本轮使用池，原因要能区分认证、限流、不可达三类。',\n    '将探针结果写入端点健康快照文件，供轮换与报告引用。',\n    '若筛选后可用端点为 0，立即停止并输出失败终态，不要启动一个注定失败的长任务。'\n  ],\n  failure: [\n    '跳过探针直接开跑：配置错误在长任务中途才爆发，已完成的部分工作全部作废。',\n    '探针请求太重：探针本身消耗额度或触发限流，等于自己制造故障。',\n    '探针结果只打印不落盘：怀疑端点有问题时拿不出实测数据，只能靠猜。',\n    '探针没有超时：一个黑洞端点让启动阶段无限期挂起，比直接失败更难排查。'\n  ],\n  callout: {\n    title: '判据：',\n    text: '探针的价值在于把失败提前。如果它不能在开跑前拦住问题，那它只是在增加启动时间。',\n    danger: false\n  },\n  spec: [\n    ['探针时机', '启动前 + 每次切换后'],\n    ['请求规模', '1 次最小调用'],\n    ['探针超时', '<code>10s</code>'],\n    ['通过判据', '200 且响应可解析'],\n    ['失败分类', '认证 / 限流 / 不可达'],\n    ['结果落盘', '<code>pool-health.json</code>']\n  ],\n  related: [\n    ['04', '供应商轮换', '04-rotation.html'],\n    ['06', '出站代理', '06-egress.html'],\n    ['11', '授权边界', '11-boundary.html']\n  ],\n  prev: ['04 供应商轮换', '04-rotation.html'],\n  next: ['06 出站代理', '06-egress.html']\n};\n\nnodeRepl.write(writePage(p05));\n","title":"Write page 05 endpoint probe"},"result":null,"error":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_44","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p05 = {\n  id: '05', name: '端点探针', en: 'Endpoint Probe', file: '05-probe.html',\n  progressLine: 'testproj/pages/05-probe.html 端点探针',\n  status: 'online', statusLabel: '在线',\n  lead: '把故障留在长任务开始之前，是探针存在的全部理由。一次最小请求的代价，远小于跑了两小时才发现凭据早就失效、或者出站链路根本不通。',\n  meta: [['当前状态', '在线运行'], ['探针规模', '1 次最小调用'], ['探针时机', '启动前 + 切换后']],\n  diagram: {\n    title: '开跑前的探针流程',\n    rows: [\n      ['任务启动，进入探针阶段而非直接开跑', '入口', ''],\n      ['对每个候选端点发出一次最小请求', '试活', ''],\n      ['校验状态码、content-type 与响应可解析性', '判定', ''],\n      ['不可用端点被剔除出池并记录原因', '筛选', 'warn'],\n      ['全部端点不可用 → 任务根本不启动', '熔断', 'warn'],\n      ['通过 → 放行长任务并写入健康快照', '放行', 'standby']\n    ]\n  },\n  what: [\n    '探针要便宜、要能解析、要能区分失败类型。一个只判断\"连接是否建立\"的探针会把 401、429 和 200 一视同仁，等于没探。',\n    '探针的意义是 fail fast：在长任务开始之前把配置错、凭据错、代理不通这三类问题挡下来。跑了一半才暴露的故障，代价是已完成的工作和额度。',\n    '探针本身必须有超时。黑洞端点不会返回错误，它什么都不返回——没有超时的探针会把启动过程一起拖住。',\n    '探针结果要落盘成健康快照，让\"端点是否可用\"从传闻变成实测数据；后续轮换的决策也应当读这份快照。'\n  ],\n  signals: [\n    ['返回 200 且响应体可解析', '端点可用，放行长任务'],\n    ['返回 401 / 403', '凭据问题：剔除该端点并明确标注为认证失败，而不是网络故障'],\n    ['返回 429', '端点可达但正被限流：标记冷却，视配额决定是否仍入池'],\n    ['探针超时或连接被拒绝', '端点不可达：剔除，并交由出站代理机制排查链路'],\n    ['全部端点探针失败', '任务不启动，直接输出失败终态与健康快照']\n  ],\n  steps: [\n    '在任务入口处强制插入探针阶段：任何长任务都不得跳过探针直接开跑。',\n    '对池中每个端点发一次最小请求（一条 ping 级别的调用），并设置独立超时（如 10 秒）。',\n    '解析响应时同时看状态码、content-type 和响应体能否被解析，避免把网关返回的 HTML 错误页当成成功。',\n    '把不可用端点连同原因一起剔出本轮使用池，原因要能区分认证、限流、不可达三类。',\n    '将探针结果写入端点健康快照文件，供轮换与报告引用。',\n    '若筛选后可用端点为 0，立即停止并输出失败终态，不要启动一个注定失败的长任务。'\n  ],\n  failure: [\n    '跳过探针直接开跑：配置错误在长任务中途才爆发，已完成的部分工作全部作废。',\n    '探针请求太重：探针本身消耗额度或触发限流，等于自己制造故障。',\n    '探针结果只打印不落盘：怀疑端点有问题时拿不出实测数据，只能靠猜。',\n    '探针没有超时：一个黑洞端点让启动阶段无限期挂起，比直接失败更难排查。'\n  ],\n  callout: {\n    title: '判据：',\n    text: '探针的价值在于把失败提前。如果它不能在开跑前拦住问题，那它只是在增加启动时间。',\n    danger: false\n  },\n  spec: [\n    ['探针时机', '启动前 + 每次切换后'],\n    ['请求规模', '1 次最小调用'],\n    ['探针超时', '<code>10s</code>'],\n    ['通过判据', '200 且响应可解析'],\n    ['失败分类', '认证 / 限流 / 不可达'],\n    ['结果落盘', '<code>pool-health.json</code>']\n  ],\n  related: [\n    ['04', '供应商轮换', '04-rotation.html'],\n    ['06', '出站代理', '06-egress.html'],\n    ['11', '授权边界', '11-boundary.html']\n  ],\n  prev: ['04 供应商轮换', '04-rotation.html'],\n  next: ['06 出站代理', '06-egress.html']\n};\n\nnodeRepl.write(writePage(p05));\n","title":"Write page 05 endpoint probe"},"result":{"content":[{"type":"text","text":"05-probe.html bytes=8996"}],"_meta":{"codex/nodeReplExecutionDurationMs":1},"structured_content":null},"error":null,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"mcp_tool_call","server":"node_repl","tool":"js","arguments":{"code":"const p06 = {\n  id: '06', name: '出站代理', en: 'Egress Proxy', file: '06-egress.html',\n  progressLine: 'testproj/pages/06-egress.html 出站代理',\n  status: 'online', statusLabel: '在线',\n  lead: '出口链路是监管系统里最容易被误判的一段：挂上代理之后，网关自己的 502 会伪装成\"模型故障\"，而 429 可能只是代理池被打满。出站代理机制的责任，是让每一跳都能被单独识别。',\n  meta: [['当前状态', '在线运行'], ['出站方式', '系统代理 / 直连'], ['排查原则', '逐跳可辨']],\n  diagram: {\n    title: '出站链路分层',\n    rows: [\n      ['客户端发起请求', '起点', ''],\n      ['出口链路：系统代理 → 中转 → 上游', '逐跳', ''],\n      ['每一跳保留可识别标记与 request-id', '标记', ''],\n      ['用一次直连最小请求做对照', '对照', ''],\n      ['直连成功而经代理失败 → 判定代理层故障', '定位', 'warn'],\n      ['定位结论写入干预存档与报告', '结论', 'standby']\n    ]\n  },\n  what: [\n    '先分层，再调参。直连发一次最小请求：如果直连成功而经代理失败，故障就在代理层。此时去调模型参数或重试逻辑，方向从一开始就错了。',\n    '不要在代理层做静默重写。错误页被替换成看起来正常的响应，会让上层把链路故障当成业务结果，错误因此被固化进产物。',\n    '出口链路上的每一跳都要能在日志里被单独识别：是谁返回了这个错误、耗时多久、状态码是什么。混在一起统计等于放弃了定位能力。',\n    '代理不是\"顺手加上去\"的东西。它需要自己的探活、超时和报告位置——否则它会以最隐蔽的方式把可用性整体拉低。'\n  ],\n  signals: [\n    ['直连成功、经代理失败', '代理层故障：排查代理配置与可用性，而不是模型或提示词'],\n    ['响应体是 HTML 而不是 JSON', '请求死在网关或代理层，未曾到达模型服务'],\n    ['代理返回 502 / 504', '记为代理层错误，与上游 5xx 分开统计，避免污染上游健康度'],\n    ['代理端口不可达', '立即失败并明确提示，不要安静退化成直连或长时间挂起'],\n    ['链路正常但延迟显著升高', '记录为性能基线变化，供报告中解释\"任务变慢\"的原因']\n  ],\n  steps: [\n    '明确当前出站方式：走系统代理还是直连，并把该信息写进每次运行的干预存档首行。',\n    '在出口链路的每一跳保留可识别标记（request-id、耗时、状态码），确保故障能被归到具体一跳。',\n    '出现可疑失败时先做对照：一次直连最小请求，用来判定故障位于代理层还是上游。',\n    '代理层错误单列统计，不并入上游 5xx；两类的处置动作不同（换链路 vs 换端点）。',\n    '为代理设置显式超时与探活，避免一个黑洞代理把整条链路一起拖住。',\n    '把定位结论写入报告，让下一次遇到同一现象时不必重新排查一遍。'\n  ],\n  failure: [\n    '代理层静默重写：错误被包装成正常响应，上层据此做出错误判断并继续推进。',\n    '没有直连对照：无法区分代理故障与上游故障，排查在错误的层面上进行。',\n    '代理错误与上游错误混统计：健康度数字失去意义，轮换与熔断的判据随之失效。',\n    '代理没有超时：请求既不成功也不失败，长任务停在一个没有超时的地方。'\n  ],\n  callout: {\n    title: '代价：',\n    text: '分不清\"模型故障\"和\"链路故障\"，就会去修错误的东西——这是监管系统里最贵的一种误判。',\n    danger: false\n  },\n  spec: [\n    ['出站方式', '系统代理 / 直连'],\n    ['识别标记', 'request-id + 逐跳耗时'],\n    ['对照手段', '一次直连最小请求'],\n    ['统计口径', '代理错误单独计数'],\n    ['超时', '必须显式设置'],\n    ['环境变量', '<code>HTTP_PROXY / HTTPS_PROXY</code>']\n  ],\n  related: [\n    ['04', '供应商轮换', '04-rotation.html'],\n    ['05', '端点探针', '05-probe.html'],\n    ['12', '终态报告', '12-report.html']\n  ],\n  prev: ['05 端点探针', '05-probe.html'],\n  next: ['07 验收清单', '07-checklist.html']\n};\n\nnodeRepl.write(writePage(p06));\n","title":"Write page 06 egress proxy"},"result":null,"error":null,"status":"in_progress"}}
