e_selftest(work_dir: Path):\r\n534:     \"\"\"selftest 12章格式: work_dir/PROGRESS.md 12项勾选 + 12个章节文件非空。\"\"\"\r\n535:     prog = work_dir / \"PROGRESS.md\"\r\n536:     if not prog.exists():\r\n537:         return False, f\"PROGRESS.md 不存在 ({work_dir})\"\r\n538:     text = prog.read_text(encoding=\"utf-8\", errors=\"replace\")\r\n539:     done = text.count(\"- [x]\") + text.count(\"- [X]\")\r\n540:     missing = [f\"ch{i:02d}\" for i in range(1, 13)\r\n541:                if not (work_dir / \"chapters\" / f\"ch{i:02d}.md\").exists()\r\n542:                or (work_dir / \"chapters\" / f\"ch{i:02d}.md\").stat().st_size < 100]\r\n543:     ok = done >= 12 and not missing\r\n544:     detail = f\"PROGRESS勾选={done}/12, 缺失章节={missing or '无'}\"\r\n545:     return ok, detail\r\n546: \r\n547: \r\n548: # ---------------------------------------------------------------- 主循环\r\n549: def main():\r\n550:     ap = argparse.ArgumentParser()\r\n551:     ap.add_argument(\"--task\", default=\"\",\r\n552:                     help=\"任务书路径; 快速模式(--adopt + --quick)可不填\")\r\n553:     ap.add_argument(\"--chaos\", default=\"\", help='故障注入, 如 \"kill:120\"')\r\n554:     ap.add_argument(\"--max-resumes\", type=int, default=8)\r\n555:     ap.add_argument(\"--max-run-sec\", type=int, default=3600,\r\n556:                     help=\"总时长上限(秒), 0=不设限; 真实数据收集建议 0\")\r\n557:     ap.add_argument(\"--no-probe\", action=\"store_true\", help=\"跳过启动探针\")\r\n558:     ap.add_argument(\"--driver\", choices=[\"claude\", \"codex\"], default=None,\r\n559:                     help=\"不填时自动推断: --adopt→codex, 否则claude\")\r\n560:     ap.add_argument(\"--work-dir\", default=\"work\",\r\n561:                     help=\"worker产物目录(相对启动cwd), 验收也在此目录\")\r\n562:     ap.add_argument(\"--adopt\", default=\"\",\r\n563:                     help=\"接管已有codex会话: 'last'(本目录最近会话) 或 session-id\")\r\n564:     ap.add_argument(\"--quick\", action=\"store_true\",\r\n565:                     help=\"快速挂机: 内置续跑指令, 验收=afk-work/PROGRESS.md全部勾完\")\r\n566:     args = ap.parse_args()\r\n567: \r\n568:     if args.driver is None:\r\n569:         args.driver = \"codex\" if args.adopt else \"claude\"\r\n570:     if not args.task and not (args.adopt and args.quick):\r\n571:         ap.error('--task 必填 (零准备挂机请用: --adopt last --quick)')\r\n572: \r\n573:     task_md = Path(args.task).resolve() if args.task else None\r\n574:     work_dir = WS / args.work_dir  # worker cwd=WS, 产物约定落在 <启动目录>/<work-dir>\r\n575:     ts = datetime.now().strftime(\"%Y%m%d-%H%M%S\")\r\n576:     run_dir = WS / \"runs\" / ts\r\n577:     run_dir.mkdir(parents=True, exist_ok=True)\r\n578:     ivl_path = run_dir / \"interventions.jsonl\"\r\n579: \r\n580:     def ivl(event, **kw):\r\n581:         rec = {\"ts\": datetime.now().isoformat(timespec=\"seconds\"), \"event\": event, **kw}\r\n582:         with open(ivl_path, \"a\", encoding=\"utf-8\") as f:\r\n583:             f.write(json.dumps(rec, ensure_ascii=False) + \"\\n\")\r\n584:         log(f\"{event} {kw if kw else ''}\")\r\n585: \r\n586:     chaos = None\r\n587:     if args.chaos:\r\n588:         parts = args.chaos.split(\":\")\r\n589:         try:\r\n590:             chaos = (parts[0],) + tuple(int(x) for x in parts[1:])\r\n591:         except ValueError:\r\n592:             ap.error('chaos 格式: kill:30 (杀进程) 或 net:30:120 (30秒时断网120秒)')\r\n593: \r\n594:     # 任务提示词: quick=内置接管指令; 任务模式=任务书+行为约束\r\n595:     prompt_path = run_dir / \"prompt.txt\"\r\n596:     if args.quick:\r\n597:         prompt_path.write_text(QUICK_PROMPT, encoding=\"utf-8\")\r\n598:     else:\r\n599:         prompt_path.write_text(\r\n600:             task_md.read_text(encoding=\"utf-8\") +\r\n601:             \"\\n\\n[运行约束] 只使用文件读取/创建/编辑工具, 禁止执行shell命令。\"\r\n602:             \"完成全部要求后停止, 不要中途停下提问。\\n\",\r\n603:             encoding=\"utf-8\")\r\n604:     resume_path = run_dir / \"resume-prompt.txt\"\r\n605:     resume_path.write_text(\r\n606:         \"你刚才被中断了(进程被终止)。请读取 work/PROGRESS.md 和 work/chapters/ 下已有文件,\"\r\n607:         \"确认已完成哪些章节, 然后继续完成全部剩余章节。不要重做已完成的工作,\"\r\n608:         \"不要中途停下提问, 只使用文件读写工具, 完成每章立即更新PROGRESS.md。\\n\",\r\n609:         encoding=\"utf-8\")\r\n610: \r\n611:     def verify():\r\n612:         \"\"\"终态验收分派: quick=afk-work清单全勾; 任务模式=acceptance.md/selftest\"\"\"\r\n613:         if args.quick:\r\n614:             return check_acceptance_quick(work_dir)\r\n615:         return check_acceptance(task_md.parent, work_dir)\r\n616: \r\n617:     keep_awake()\r\n618:     proxy = detect_system_proxy()\r\n619:     ivl(\"EGRESS\", proxy=proxy or \"(直连)\", driver=args.driver)\r\n620:     if args.driver == \"claude\":\r\n621:         pool = get_relay_pool(\"claude-desktop\")\r\n622:         if args.no_probe:\r\n623:             working = pool\r\n624:         else:\r\n625:             working = probe_pool(pool, proxy)\r\n626:             if not working:\r\n627:                 ivl(\"TERMINAL\", state=\"FAILED\",\r\n628:                     detail=f\"探针筛出0个可用端点(池{len(pool)}个, 代理={proxy or '直连'})。\"\r\n629:                            f\"可能: 中转全体故障 / token均不兼容CLI / 代理端口死。详见 pool-health.json\")\r\n630:                 log(\"TERMINAL FAILED — SHUTDOWN WOULD HAPPEN HERE\")\r\n631:                 return 1\r\n632:         driver = ClaudeDriver(WS, run_dir, working, proxy)\r\n633:     else:\r\n634:         driver = CodexDriver(WS, run_dir)\r\n635:         if args.adopt:\r\n636:             if args.adopt == \"last\":\r\n637:                 found = find_last_codex_session(WS)\r\n638:                 if not found:\r\n639:                     ivl(\"TERMINAL\", state=\"FAILED\", detail=\"未找到可接管的codex会话\")\r\n640:                     log(\"TERMINAL FAILED — SHUTDOWN WOULD HAPPEN HERE\")\r\n641:                     return 1\r\n642:                 sid, rollout, scwd = found\r\n643:                 if scwd and scwd != str(WS):\r\n644:                     log(f\"WARN    接管全局最新会话 cwd={scwd} (非{WS}), 验收锚点随之转移\")\r\n645:             else:\r\n646:                 got = find_codex_session_by_id(args.adopt)\r\n647:                 if not got:\r\n648:                     ivl(\"TERMINAL\", state=\"FAILED\", detail=f\"找不到会话 {args.adopt}\")\r\n649:                     log(\"TERMINAL FAILED — SHUTDOWN WOULD HAPPEN HERE\")\r\n650:                     return 1\r\n651:                 rollout, scwd = got\r\n652:                 sid = args.adopt\r\n653:             ivl(\"ADOPT\", session=sid,\r\n654:                 rollout=rollout.name[:60] if rollout else \"(文件未定位)\",\r\n655:                 session_cwd=scwd or \"?\")\r\n656:             if rollout:\r\n657:                 wait_session_quiet(rollout)\r\n658:             driver.session_id = sid\r\n659:             driver.jsonl = rollout  # 心跳基线; resume后由 discover_session 重新定位\r\n660:             if scwd:\r\n661:                 # 验收锚点跟随被接管会话; quick模式固定用 afk-work\r\n662:                 work_dir = Path(scwd) / (\"afk-work\" if args.quick else args.work_dir)\r\n663:     ivl(\"LAUNCH\", session=driver.session_id or \"(运行时发现)\",\r\n664:         provider=driver.provider_name,\r\n665:         chaos=str(chaos) if chaos else \"off\")\r\n666: \r\n667:     # quick模式: 归档上一轮遗留的清单, 否则旧清单会让验收瞬间假通过\r\n668:     if args.quick:\r\n669:         prog = work_dir / \"PROGRESS.md\"\r\n670:         if prog.exists():\r\n671:             arch = work_dir / \"archive\"\r\n672:             arch.mkdir(parents=True, exist_ok=True)\r\n673:             dest = arch / f\"PROGRESS-{ts}.md\"\r\n674:             try:\r\n675:                 prog.replace(dest)\r\n676:                 ivl(\"ARCHIVE_STALE_CHECKLIST\", dest=str(dest))\r\n677:             except OSError as e:\r\n678:                 ivl(\"WARN\", msg=f\"归档旧清单失败: {e}\")\r\n679: \r\n680:     launched_at = time.time()\r\n681:     run_started_at = launched_at  # 总时长上限的计时基准(含所有退避)\r\n682:     worker_runtime = 0.0        # 累计运行时间(不含resume退避), chaos计时基准\r\n683:     chaos_fired = False\r\n684:     resumes = 0\r\n685:     busy_waits = 0              # SESSION_BUSY 耐心等待次数(不占resume预算)\r\n686:     early_exits = 0             # worker空转退出(rc=0但验收不过)计数→矛盾态熔断\r\n687:     total_kills = 0             # 梯度心跳阈值基准\r\n688:     net_off_adapter = None      # 断网chaos: 当前被断的网卡\r\n689:     net_on_wall = 0.0           # 恢复时刻(wall clock, worker死了也要恢复)\r\n690:     fails_on_provider = 0       # 当前供应商连续死亡计数\r\n691:     providers_tried = [driver.provider_name]\r\n692:     last_hb_log = 0.0\r\n693:     last_error_note = \"\"\r\n694:     outcome, outcome_detail = None, \"\"\r\n695: \r\n696:     if args.driver == \"codex\" and args.adopt:\r\n697:         driver.resume(prompt_path)  # 接管 = 对既有会话发出续跑指令\r\n698:         ivl(\"ADOPTED_RESUME\", pid=driver.proc.pid)\r\n699:     else:\r\n700:         driver.launch(prompt_path)\r\n701:         ivl(\"SPAWNED\", pid=driver.proc.pid)\r\n702: \r\n703:     while True:\r\n704:         time.sleep(5)\r\n705:         now = time.time()\r\n706:         if hasattr(driver, \"discover_session\"):  # codex: 每次 spawn 后重新发现 rollout\r\n707:             driver.discover_session(launched_at)\r\n708:         alive = driver.proc.poll() is None\r\n709:         if alive:\r\n710:             worker_runtime += 5\r\n711: \r\n712:         # --- chaos 注入 (一次性) ---\r\n713:         if chaos and not chaos_fired and alive:\r\n714:             if chaos[0] == \"kill\" and worker_runtime >= chaos[1]:\r\n715:                 chaos_fired = True\r\n716:                 ivl(\"CHAOS_KILL\", at_sec=worker_runtime)\r\n717:                 driver.kill_tree()\r\n718:             elif chaos[0] == \"net\" and worker_runtime >= chaos[1]:\r\n719:                 chaos_fired = True\r\n720:                 adapter = find_connected_adapter()\r\n","exit_code":0,"status":"completed"}}
