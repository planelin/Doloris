{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$content = @'\"'\n# 认证失效\n\n认证失效可能由访问令牌过期、密钥轮换、会话撤销、时钟偏差或权限策略变更引起。Agent在执行长任务时，启动阶段有效的凭据未必能维持到结束，因此应识别未授权与禁止访问的区别，记录凭据来源、作用域和到期时间。遇到认证错误后，先暂停依赖该身份的高风险操作，尝试使用安全刷新流程获取新令牌，并避免把旧凭据反复提交给服务端。若刷新失败，应保存现场并请求授权方重新登录，而不是绕过校验或扩大权限。日志中必须脱敏令牌、Cookie和密钥，审计事件则记录刷新、失败和权限变更，便于定位连锁故障。\n'@\nSet-Content -LiteralPath .\\\\afk-work\\\\chapters-sim2\\\\ch03.md -Value \"'$content -Encoding utf8\n$path = '\"'.\\\\afk-work\\\\PROGRESS.md'\n\"'$text = Get-Content -LiteralPath $path -Raw -Encoding utf8\n$text = $text.Replace('\"'- [ ] 在 \"'`afk-work/chapters-sim2/ch03.md` 写入“认证失效”主题内容（至少 80 字）'\"', '- [x] 在 \"'`afk-work/chapters-sim2/ch03.md` 写入“认证失效”主题内容（至少 80 字）'\"')\nSet-Content -LiteralPath \"'$path -Value $text -Encoding utf8 -NoNewline'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
