{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$content = @'\"'\n# 配额耗尽\n\n配额耗尽包括请求次数、令牌数量、并发连接、存储空间或调用预算达到上限，表现为限流错误、拒绝服务和任务排队。Agent应把配额视为可观测资源，在每次调用前检查剩余额度，并区分账户级、模型级和工具级限制。接近阈值时应降低并发、压缩上下文、选择更经济的模型，或把非关键步骤延后。若已耗尽，不得通过高频重试制造更多失败，而应进入受控退避和降级模式，向用户说明影响范围，保留检查点，待额度恢复后从断点继续。预算监测还应设置预警线和硬上限，防止异常循环在短时间内烧光全部资源。\n'@\nSet-Content -LiteralPath .\\\\afk-work\\\\chapters-sim2\\\\ch02.md -Value \"'$content -Encoding utf8\n$path = '\"'.\\\\afk-work\\\\PROGRESS.md'\n\"'$text = Get-Content -LiteralPath $path -Raw -Encoding utf8\n$text = $text.Replace('\"'- [ ] 在 \"'`afk-work/chapters-sim2/ch02.md` 写入“配额耗尽”主题内容（至少 80 字）'\"', '- [x] 在 \"'`afk-work/chapters-sim2/ch02.md` 写入“配额耗尽”主题内容（至少 80 字）'\"')\nSet-Content -LiteralPath \"'$path -Value $text -Encoding utf8 -NoNewline'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
