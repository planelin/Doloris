; flex-wrap: wrap; gap: 10px 22px; margin-top: 28px; color: var(--muted); font-size: 0.82rem; }\n.meta-strip span { display: inline-flex; align-items: center; gap: 8px; }\n.meta-strip span::before { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); content: \\\"\\\"; }\n.article-content { max-width: 760px; margin-inline: auto; padding: 26px 0 50px; }\n.article-content section { padding: 54px 0; border-bottom: 1px solid var(--line); }\n.article-content section:last-child { border-bottom: 0; }\n.article-content p:not(.section-index) { color: #b8cbd3; font-size: 1.03rem; }\n.article-content h2 { margin-bottom: 22px; }\n.section-index { margin-bottom: 12px; color: var(--accent); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; text-shadow: 0 0 14px var(--accent-glow); }\n.callout {\n  margin-top: 30px;\n  padding: 22px 24px;\n  border: 1px solid rgba(32, 227, 194, 0.3);\n  border-left: 4px solid var(--accent);\n  border-radius: 0 var(--radius) var(--radius) 0;\n  background: linear-gradient(90deg, rgba(32, 227, 194, 0.11), rgba(41, 169, 255, 0.045));\n  box-shadow: inset 0 0 28px rgba(32, 227, 194, 0.035);\n}\n.callout strong { display: block; margin-bottom: 4px; color: var(--accent); }\n.callout p { margin-bottom: 0 \"'!important; }\n.article-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 38px 0 88px; border-top: 1px solid var(--line); }\n.article-pager a {\n  display: flex;\n  flex-direction: column;\n  padding: 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: rgba(10, 18, 25, 0.86);\n  text-decoration: none;\n  transition: border-color 160ms ease, box-shadow 160ms ease;\n}\n.article-pager a:last-child { align-items: flex-end; text-align: right; }\n.article-pager span { color: var(--muted); font-size: 0.78rem; }\n.article-pager a:hover { border-color: var(--accent); box-shadow: 0 0 24px rgba(32, 227, 194, 0.09); }\n\n.page-heartbeat { --accent: #20e3c2; --accent-alt: #2bb9ff; --accent-glow: rgba(32, 227, 194, 0.34); }\n.page-takeover { --accent: #29c8ff; --accent-alt: #20e3c2; --accent-glow: rgba(41, 200, 255, 0.34); }\n.page-decision { --accent: #42f5a1; --accent-alt: #29c8ff; --accent-glow: rgba(66, 245, 161, 0.32); }\n.page-report { --accent: #35d8ff; --accent-alt: #2fffb2; --accent-glow: rgba(53, 216, 255, 0.32); }\n\n@media (max-width: 900px) {\n  .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .nav { align-items: flex-start; flex-direction: column; padding-block: 16px; }\n  .nav-links { justify-content: flex-start; }\n}\n\n@media (max-width: 620px) {\n  :root { --shell: min(100% - 28px, 1120px); }\n  body { background-size: 32px 32px, 32px 32px, auto, auto, auto; }\n  .nav-links { gap: 8px 14px; }\n  .hero { padding-top: 58px; }\n  .section { padding: 62px 0; }\n  .section-heading, .principles { grid-template-columns: 1fr; gap: 14px; }\n  .card-grid { grid-template-columns: 1fr; }\n  .experiment-card { min-height: 220px; }\n  .breadcrumb { margin-bottom: 48px; }\n  .article-content section { padding: 42px 0; }\n  .article-pager { grid-template-columns: 1fr; }\n  .article-pager a:last-child { align-items: flex-start; text-align: left; }\n  .footer-inner { align-items: flex-start; flex-direction: column; justify-content: center; padding-block: 18px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  *, *::before, *::after { transition-duration: 0.01ms !important; }\n}\n'\"'@\nSet-Content -LiteralPath 'decisionlab\\\\assets\\\\style.css' -Value \"'$style -Encoding utf8\n$progress = @'\"'\n# 决策实验站进度\n\n- [x] 基建\n- [x] 内容页\n- [x] 主题应用\n- [ ] 语言应用\n- [ ] 配置记录\n- [ ] 说明文档\n'@\nSet-Content -LiteralPath 'decisionlab\\\\PROGRESS.md' -Value \"'$progress -Encoding utf8'","aggregated_output":"","exit_code":0,"status":"completed"}}
