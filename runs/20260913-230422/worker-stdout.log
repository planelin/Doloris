{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$style = @'\"'\n:root {\n  color-scheme: dark;\n  --bg: #05090d;\n  --bg-deep: #020508;\n  --surface: #0a1219;\n  --surface-strong: #0e1a22;\n  --text: #e9fbff;\n  --muted: #91a8b3;\n  --line: #1b3540;\n  --line-bright: #2c6972;\n  --accent: #20e3c2;\n  --accent-alt: #29a9ff;\n  --accent-soft: rgba(32, 227, 194, 0.1);\n  --accent-glow: rgba(32, 227, 194, 0.34);\n  --blue-glow: rgba(41, 169, 255, 0.26);\n  --shadow: 0 22px 64px rgba(0, 0, 0, 0.48);\n  --radius: 16px;\n  --shell: min(1120px, calc(100% - 40px));\n}\n\n* { box-sizing: border-box; }\n\nhtml { scroll-behavior: smooth; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background:\n    linear-gradient(rgba(41, 169, 255, 0.035) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(41, 169, 255, 0.035) 1px, transparent 1px),\n    radial-gradient(circle at 82% 3%, rgba(32, 227, 194, 0.13), transparent 27rem),\n    radial-gradient(circle at 8% 24%, rgba(41, 169, 255, 0.1), transparent 30rem),\n    var(--bg);\n  background-attachment: fixed;\n  background-size: 48px 48px, 48px 48px, auto, auto, auto;\n  color: var(--text);\n  font-family: \\\"Segoe UI\\\", \\\"PingFang SC\\\", \\\"Microsoft YaHei\\\", sans-serif;\n  line-height: 1.7;\n}\n\na { color: inherit; }\n\n::selection { background: var(--accent); color: var(--bg-deep); }\n\n.skip-link {\n  position: fixed;\n  left: 16px;\n  top: -80px;\n  z-index: 20;\n  padding: 10px 14px;\n  background: var(--accent);\n  color: var(--bg-deep);\n  border-radius: 8px;\n  font-weight: 800;\n}\n\n.skip-link:focus { top: 16px; }\n\n.shell { width: var(--shell); margin-inline: auto; }\n\n.site-header {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  border-bottom: 1px solid rgba(41, 169, 255, 0.18);\n  background: rgba(5, 9, 13, 0.82);\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.28);\n  backdrop-filter: blur(18px) saturate(138%);\n}\n\n.nav {\n  min-height: 74px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 28px;\n}\n\n.brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 11px;\n  text-decoration: none;\n  letter-spacing: 0.01em;\n}\n\n.brand-mark {\n  display: grid;\n  width: 38px;\n  height: 38px;\n  place-items: center;\n  border: 1px solid var(--accent);\n  border-radius: 9px;\n  background: linear-gradient(135deg, rgba(32, 227, 194, 0.18), rgba(41, 169, 255, 0.1));\n  color: var(--accent);\n  box-shadow: inset 0 0 18px rgba(32, 227, 194, 0.13), 0 0 18px rgba(32, 227, 194, 0.14);\n  font-size: 0.74rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n}\n\n.brand strong, .brand small { display: block; }\n.brand strong { font-size: 0.94rem; line-height: 1.25; }\n.brand small { color: var(--muted); font-size: 0.69rem; letter-spacing: 0.1em; text-transform: uppercase; }\n\n.nav-links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 22px; }\n.nav-links a { position: relative; color: var(--muted); font-size: 0.9rem; text-decoration: none; transition: color 160ms ease, text-shadow 160ms ease; }\n.nav-links a:hover, .nav-links a[aria-current=\\\"page\\\"] { color: var(--accent); text-shadow: 0 0 14px var(--accent-glow); }\n.nav-links a[aria-current=\\\"page\\\"]::after {\n  position: absolute;\n  right: 0;\n  bottom: -8px;\n  left: 0;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, var(--accent), transparent);\n  box-shadow: 0 0 8px var(--accent);\n  content: \\\"\\\";\n}\n\n.hero { padding: clamp(72px, 11vw, 136px) 0 86px; max-width: 900px; }\n.eyebrow {\n  margin: 0 0 16px;\n  color: var(--accent);\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.16em;\n  text-shadow: 0 0 18px var(--accent-glow);\n}\n\nh1, h2, h3, p { margin-top: 0; }\nh1 {\n  max-width: 820px;\n  margin-bottom: 26px;\n  color: #f3fdff;\n  font-size: clamp(2.65rem, 7vw, 5.7rem);\n  line-height: 0.98;\n  letter-spacing: -0.055em;\n  text-shadow: 0 0 42px rgba(41, 169, 255, 0.13);\n}\nh2 { margin-bottom: 12px; font-size: clamp(1.8rem, 3vw, 2.75rem); line-height: 1.15; letter-spacing: -0.03em; }\nh3 { margin-bottom: 10px; font-size: 1.2rem; line-height: 1.3; }\n\n.hero-copy { max-width: 690px; color: var(--muted); font-size: clamp(1.03rem, 2vw, 1.24rem); }\n.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }\n\n.button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 46px;\n  padding: 0 20px;\n  border: 1px solid var(--line-bright);\n  border-radius: 8px;\n  text-decoration: none;\n  font-weight: 700;\n  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;\n}\n\n.button.primary {\n  border-color: var(--accent);\n  background: linear-gradient(135deg, var(--accent), #30b7ff);\n  color: #031013;\n  box-shadow: 0 0 24px rgba(32, 227, 194, 0.22);\n}\n.button.secondary { background: rgba(10, 18, 25, 0.78); color: var(--text); }\n.button:hover, .button:focus-visible { transform: translateY(-2px); border-color: var(--accent-alt); box-shadow: 0 0 24px var(--blue-glow); }\n\n.section { padding: 84px 0; border-top: 1px solid var(--line); }\n.section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 0.55fr); align-items: end; gap: 32px; margin-bottom: 34px; }\n.section-heading > p { color: var(--muted); }\n\n.card-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }\n.experiment-card {\n  position: relative;\n  min-height: 255px;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  padding: 22px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: linear-gradient(160deg, rgba(14, 26, 34, 0.96), rgba(7, 14, 20, 0.94));\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.025);\n  text-decoration: none;\n  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;\n}\n.experiment-card::before {\n  position: absolute;\n  top: 0;\n  left: 22px;\n  width: 42px;\n  height: 2px;\n  background: var(--accent);\n  box-shadow: 0 0 14px var(--accent);\n  content: \\\"\\\";\n}\n.experiment-card:hover, .experiment-card:focus-visible {\n  transform: translateY(-5px);\n  border-color: var(--accent);\n  box-shadow: var(--shadow), 0 0 32px rgba(32, 227, 194, 0.12);\n}\n.experiment-card p { color: var(--muted); font-size: 0.94rem; }\n.card-number { margin-bottom: 38px; color: var(--accent-alt); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-shadow: 0 0 12px var(--blue-glow); }\n.card-link { margin-top: auto; color: var(--accent); font-size: 0.88rem; font-weight: 700; }\n\n.principles {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 56px;\n  margin-block: 30px 96px;\n  padding: clamp(30px, 5vw, 54px);\n  border: 1px solid var(--line-bright);\n  border-radius: calc(var(--radius) + 8px);\n  background: linear-gradient(120deg, rgba(10, 27, 34, 0.96), rgba(5, 16, 25, 0.92));\n  box-shadow: inset 0 0 36px rgba(32, 227, 194, 0.045), 0 18px 50px rgba(0, 0, 0, 0.22);\n}\n.principles > p { align-self: end; margin-bottom: 0; color: var(--muted); }\n\n.site-footer { border-top: 1px solid var(--line); background: rgba(2, 5, 8, 0.72); }\n.footer-inner { min-height: 86px; display: flex; align-items: center; justify-content: space-between; gap: 20px; color: var(--muted); font-size: 0.85rem; }\n\n/* 内容页 */\n.article-shell { max-width: 940px; padding-top: 40px; }\n.breadcrumb { display: flex; gap: 9px; margin-bottom: 72px; color: var(--muted); font-size: 0.83rem; }\n.breadcrumb a { color: var(--accent); text-decoration: none; }\n.article-hero { padding-bottom: 56px; border-bottom: 1px solid var(--line); }\n.article-hero h1 { max-width: 880px; font-size: clamp(2.45rem, 6vw, 4.8rem); }\n.article-lead { max-width: 760px; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.22rem); }\n.meta-strip { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 28px; color: var(--muted); font-size: 0.82rem; }\n.meta-strip span { display: inline-flex; align-items: center; gap: 8px; }\n.meta-strip span::before { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); content: \\\"\\\"; }\n.article-content { max-width: 760px; margin-inline: auto; padding: 26px 0 50px; }\n.article-content section { padding: 54px 0; border-bottom: 1px solid var(--line); }\n.article-content section:last-child { border-bottom: 0; }\n.article-content p:not(.section-index) { color: #b8cbd3; font-size: 1.03rem; }\n.article-content h2 { margin-bottom: 22px; }\n.section-index { margin-bottom: 12px; color: var(--accent); font-size: 0.74rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; text-shadow: 0 0 14px var(--accent-glow); }\n.callout {\n  margin-top: 30px;\n  padding: 22px 24px;\n  border: 1px solid rgba(32, 227, 194, 0.3);\n  border-left: 4px solid var(--accent);\n  border-radius: 0 var(--radius) var(--radius) 0;\n  background: linear-gradient(90deg, rgba(32, 227, 194, 0.11), rgba(41, 169, 255, 0.045));\n  box-shadow: inset 0 0 28px rgba(32, 227, 194, 0.035);\n}\n.callout strong { display: block; margin-bottom: 4px; color: var(--accent); }\n.callout p { margin-bottom: 0 \"'!important; }\n.article-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; padding: 38px 0 88px; border-top: 1px solid var(--line); }\n.article-pager a {\n  display: flex;\n  flex-direction: column;\n  padding: 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: rgba(10, 18, 25, 0.86);\n  text-decoration: none;\n  transition: border-color 160ms ease, box-shadow 160ms ease;\n}\n.article-pager a:last-child { align-items: flex-end; text-align: right; }\n.article-pager span { color: var(--muted); font-size: 0.78rem; }\n.article-pager a:hover { border-color: var(--accent); box-shadow: 0 0 24px rgba(32, 227, 194, 0.09); }\n\n.page-heartbeat { --accent: #20e3c2; --accent-alt: #2bb9ff; --accent-glow: rgba(32, 227, 194, 0.34); }\n.page-takeover { --accent: #29c8ff; --accent-alt: #20e3c2; --accent-glow: rgba(41, 200, 255, 0.34); }\n.page-decision { --accent: #42f5a1; --accent-alt: #29c8ff; --accent-glow: rgba(66, 245, 161, 0.32); }\n.page-report { --accent: #35d8ff; --accent-alt: #2fffb2; --accent-glow: rgba(53, 216, 255, 0.32); }\n\n@media (max-width: 900px) {\n  .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  .nav { align-items: flex-start; flex-direction: column; padding-block: 16px; }\n  .nav-links { justify-content: flex-start; }\n}\n\n@media (max-width: 620px) {\n  :root { --shell: min(100% - 28px, 1120px); }\n  body { background-size: 32px 32px, 32px 32px, auto, auto, auto; }\n  .nav-links { gap: 8px 14px; }\n  .hero { padding-top: 58px; }\n  .section { padding: 62px 0; }\n  .section-heading, .principles { grid-template-columns: 1fr; gap: 14px; }\n  .card-grid { grid-template-columns: 1fr; }\n  .experiment-card { min-height: 220px; }\n  .breadcrumb { margin-bottom: 48px; }\n  .article-content section { padding: 42px 0; }\n  .article-pager { grid-template-columns: 1fr; }\n  .article-pager a:last-child { align-items: flex-start; text-align: left; }\n  .footer-inner { align-items: flex-start; flex-direction: column; justify-content: center; padding-block: 18px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n  *, *::before, *::after { transition-duration: 0.01ms !important; }\n}\n'\"'@\nSet-Content -LiteralPath 'decisionlab\\\\assets\\\\style.css' -Value \"'$style -Encoding utf8\n$progress = @'\"'\n# 决策实验站进度\n\n- [x] 基建\n- [x] 内容页\n- [x] 主题应用\n- [ ] 语言应用\n- [ ] 配置记录\n- [ ] 说明文档\n'@\nSet-Content -LiteralPath 'decisionlab\\\\PROGRESS.md' -Value \"'$progress -Encoding utf8'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
