section-shell flow-section reveal\" id=\"control-loop\">\n      <div class=\"section-heading compact\">\n        <div>\n          <p class=\"eyebrow\"><span>CONTROL LOOP</span> / SIGNAL PATH</p>\n          <h2>鐩戠闂幆</h2>\n        </div>\n        <p class=\"section-note\">涓€娆′俊鍙蜂粠浜х敓鍒拌惤妗ｇ殑鍏稿瀷璺緞銆?/p>\n      </div>\n      <ol class=\"flow-track\">\n        <li>\n          <span class=\"flow-index\">01</span>\n          <div><strong>瑙傛祴</strong><small>蹇冭烦涓庣鐐规帰閽堥噰闆嗙姸鎬?/small></div>\n        </li>\n        <li>\n          <span class=\"flow-index\">02</span>\n          <div><strong>鍒ゅ畾</strong><small>闃堝€笺€侀€€閬夸笌鎺堟潈杈圭晫姣斿</small></div>\n        </li>\n        <li>\n          <span class=\"flow-index\">03</span>\n          <div><strong>鎺у埗</strong><small>鎺ョ浼氳瘽鎴栧垏鎹㈠彲鐢ㄤ緵搴斿晢</small></div>\n        </li>\n        <li>\n          <span class=\"flow-index\">04</span>\n          <div><strong>褰掓。</strong><small>骞查璁板綍涓庣粓鎬佹姤鍛婃矇娣€</small></div>\n        </li>\n      </ol>\n    </section>\n\n    <section class=\"section-shell console-grid\">\n      <article class=\"panel reveal\">\n        <div class=\"panel-heading\">\n          <div>\n            <p class=\"eyebrow\"><span>STATUS BOARD</span></p>\n            <h3>鏈哄埗鐘舵€佹瑙?/h3>\n          </div>\n          <span class=\"panel-code\">LIVE / LOCAL</span>\n        </div>\n        <div class=\"status-list\" id=\"status-list\" aria-live=\"polite\">\n          <p class=\"muted\">鐘舵€佹暟鎹浇鍏ヤ腑鈥?/p>\n        </div>\n      </article>\n\n      <article class=\"panel reveal\">\n        <div class=\"panel-heading\">\n          <div>\n            <p class=\"eyebrow\"><span>OPERATING RULES</span></p>\n            <h3>鐩戠鍘熷垯</h3>\n          </div>\n          <span class=\"panel-code\">POLICY</span>\n        </div>\n        <div class=\"principle-list\">\n          <div><span>01</span><p><strong>鍏堣娴嬶紝鍐嶅共棰?/strong>浠讳綍鑷姩鍔ㄤ綔閮藉繀椤绘潵鑷彲澶嶇幇鐨勪俊鍙枫€?/p></div>\n          <div><span>02</span><p><strong>鏈€灏忔巿鏉?/strong>鎺ョ涓庤疆鎹㈠彧鍦ㄩ瀹氫箟杈圭晫鍐呭彂鐢熴€?/p></div>\n          <div><span>03</span><p><strong>缁堟€佸彲瑙?/strong>鎴愬姛銆佸け璐ヤ笌鏀惧純閮藉繀椤荤暀涓嬫槑纭粨璁恒€?/p></div>\n        </div>\n      </article>\n    </section>\n  </main>\n\n  <footer class=\"site-footer section-shell\">\n    <div>\n      <a class=\"brand footer-brand\" href=\"index.html\">\n        <span class=\"brand-mark\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n        <span><strong>Agent Oversight</strong><small>闈欐€佺洃鎺у彴</small></span>\n      </a>\n      <p>绾潤鎬佺晫闈紝鏃犲悗绔緷璧栵紱鏈哄埗鎽樿鐢辨湰鍦?JSON 椹卞姩銆?/p>\n    </div>\n    <p class=\"footer-meta\">12 MECHANISMS / CONTROL PLANE<br><span id=\"footer-time\">鏈湴鏃堕棿 --:--</span></p>\n  </footer>\n\n  <script src=\"assets/app.js\" defer></script>\n</body>\n</html>\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content testproj/assets/style.css -Raw'","aggregated_output":"/* ============================================================\n   Agent 鐩戠绯荤粺鐩戞帶鍙?路 鍏ㄧ珯鏍峰紡\n   绾潤鎬? 鏃犲閮ㄤ緷璧?(瀛椾綋/鍥炬爣鍧囦负绯荤粺鏍?+ 鍐呰仈 SVG)\n   ============================================================ */\n\n:root {\n  --bg: #07110f;\n  --bg-soft: #0a1715;\n  --panel: rgba(11, 27, 24, 0.82);\n  --panel-solid: #0c1d1a;\n  --line: rgba(120, 219, 190, 0.16);\n  --line-strong: rgba(120, 219, 190, 0.34);\n  --text: #e7f4f0;\n  --text-dim: #b6cdc7;\n  --muted: #7f9c96;\n  --accent: #4ee0a8;\n  --accent-soft: rgba(78, 224, 168, 0.14);\n  --accent-2: #5cc8ff;\n  --watch: #ffc95c;\n  --watch-soft: rgba(255, 201, 92, 0.14);\n  --standby: #8f9dad;\n  --standby-soft: rgba(143, 157, 173, 0.14);\n  --danger: #ff7a7a;\n  --radius-lg: 22px;\n  --radius: 14px;\n  --radius-sm: 9px;\n  --shadow: 0 24px 60px rgba(0, 0, 0, 0.45);\n  --mono: \"JetBrains Mono\", \"Cascadia Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n  --sans: \"Inter\", \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", \"Hiragino Sans GB\", system-ui, sans-serif;\n}\n\n* { box-sizing: border-box; }\n\nhtml { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background:\n    radial-gradient(1200px 600px at 12% -10%, rgba(78, 224, 168, 0.10), transparent 60%),\n    radial-gradient(900px 520px at 92% 8%, rgba(92, 200, 255, 0.08), transparent 62%),\n    linear-gradient(180deg, #07110f 0%, #050d0c 100%);\n  color: var(--text);\n  font-family: var(--sans);\n  font-size: 16px;\n  line-height: 1.65;\n  letter-spacing: 0.01em;\n  overflow-x: hidden;\n}\n\nimg, svg { max-width: 100%; }\n\na { color: inherit; text-decoration: none; }\n\na:focus-visible,\nbutton:focus-visible {\n  outline: 2px solid var(--accent);\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n::selection { background: rgba(78, 224, 168, 0.28); }\n\n/* ---------------------------------------------- 閫氱敤鏋勪欢 */\n\n.skip-link {\n  position: absolute;\n  left: -9999px;\n  top: 0;\n  z-index: 40;\n  padding: 10px 16px;\n  background: var(--accent);\n  color: #04120e;\n  font-weight: 700;\n  border-radius: 0 0 10px 0;\n}\n\n.skip-link:focus {\n  left: 0;\n}\n\n.section-shell {\n  width: min(1180px, calc(100% - 48px));\n  margin-inline: auto;\n}\n\n.eyebrow {\n  margin: 0 0 14px;\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.eyebrow span { color: var(--accent); }\n\nh1, h2, h3, h4 { line-height: 1.2; margin: 0; font-weight: 650; }\n\nh1 { font-size: clamp(30px, 4.4vw, 52px); letter-spacing: -0.02em; }\n\nh2 { font-size: clamp(23px, 2.6vw, 32px); letter-spacing: -0.01em; }\n\nh3 { font-size: 19px; }\n\np { margin: 0 0 14px; color: var(--text-dim); }\n\n.muted { color: var(--muted); }\n\n.ambient {\n  position: fixed;\n  z-index: 0;\n  pointer-events: none;\n  filter: blur(90px);\n  opacity: 0.5;\n}\n\n.ambient-a {\n  width: 420px;\n  height: 420px;\n  top: -160px;\n  left: -120px;\n  background: rgba(78, 224, 168, 0.22);\n}\n\n.ambient-b {\n  width: 360px;\n  height: 360px;\n  right: -120px;\n  top: 240px;\n  background: rgba(92, 200, 255, 0.16);\n}\n\n/* ---------------------------------------------- 椤舵爮 */\n\n.topbar {\n  position: sticky;\n  top: 0;\n  z-index: 20;\n  display: flex;\n  align-items: center;\n  gap: 24px;\n  padding: 14px clamp(16px, 4vw, 42px);\n  background: rgba(6, 16, 14, 0.86);\n  backdrop-filter: blur(14px);\n  border-bottom: 1px solid var(--line);\n}\n\n.brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  flex: 0 0 auto;\n}\n\n.brand-mark {\n  display: inline-flex;\n  gap: 3px;\n  align-items: flex-end;\n  height: 22px;\n}\n\n.brand-mark i {\n  display: block;\n  width: 4px;\n  border-radius: 2px;\n  background: linear-gradient(180deg, var(--accent), rgba(78, 224, 168, 0.35));\n}\n\n.brand-mark i:nth-child(1) { height: 10px; }\n.brand-mark i:nth-child(2) { height: 18px; }\n.brand-mark i:nth-child(3) { height: 14px; }\n\n.brand-type { display: flex; flex-direction: column; line-height: 1.15; }\n\n.brand-type strong { font-size: 15px; letter-spacing: 0.06em; }\n\n.brand-type small { font-size: 11px; color: var(--muted); letter-spacing: 0.16em; }\n\n.topnav {\n  display: flex;\n  gap: 6px;\n  margin-inline: auto;\n  flex-wrap: wrap;\n}\n\n.topnav a {\n  padding: 8px 14px;\n  border-radius: 999px;\n  font-size: 14px;\n  color: var(--text-dim);\n  border: 1px solid transparent;\n  transition: color 0.2s, border-color 0.2s, background 0.2s;\n}\n\n.topnav a:hover { color: var(--text); border-color: var(--line); background: rgba(255, 255, 255, 0.02); }\n\n.topnav a.is-active {\n  color: var(--accent);\n  border-color: var(--line-strong);\n  background: var(--accent-soft);\n}\n\n.topbar-meta {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  flex: 0 0 auto;\n  font-family: var(--mono);\n  font-size: 12px;\n  color: var(--muted);\n}\n\n.live-indicator {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 11px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  color: var(--text-dim);\n}\n\n.live-indicator i {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--accent);\n  box-shadow: 0 0 0 0 rgba(78, 224, 168, 0.6);\n  animation: pulse 2.4s infinite;\n}\n\n#clock { min-width: 74px; text-align: right; color: var(--text-dim); }\n\n.icon-button {\n  display: inline-grid;\n  place-items: center;\n  width: 34px;\n  height: 34px;\n  border-radius: 10px;\n  border: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.02);\n  color: var(--text-dim);\n  cursor: pointer;\n  transition: color 0.2s, border-color 0.2s, transform 0.4s;\n}\n\n.icon-button svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n\n.icon-button:hover { color: var(--accent); border-color: var(--line-strong); }\n\n.icon-button.is-spinning { transform: rotate(360deg); }\n\n@keyframes pulse {\n  0% { box-shadow: 0 0 0 0 rgba(78, 224, 168, 0.55); }\n  70% { box-shadow: 0 0 0 9px rgba(78, 224, 168, 0); }\n  100% { box-shadow: 0 0 0 0 rgba(78, 224, 168, 0); }\n}\n\n/* ---------------------------------------------- 棣栭〉 Hero */\n\nmain { position: relative; z-index: 1; }\n\n.hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);\n  gap: clamp(28px, 5vw, 64px);\n  align-items: center;\n  padding: clamp(48px, 8vw, 96px) 0 clamp(32px, 5vw, 64px);\n}\n\n.hero h1 em {\n  font-style: normal;\n  color: var(--accent);\n  background: linear-gradient(90deg, var(--accent), var(--accent-2));\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.hero-lead { max-width: 54ch; margin-top: 18px; font-size: 17px; }\n\n.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 26px 0 30px; }\n\n.button {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 12px 20px;\n  border-radius: 999px;\n  font-size: 15px;\n  font-weight: 600;\n  border: 1px solid var(--line);\n  color: var(--text);\n  background: rgba(255, 255, 255, 0.02);\n  transition: transform 0.18s, border-color 0.2s, background 0.2s, color 0.2s;\n}\n\n.button:hover { transform: translateY(-2px); }\n\n.button-primary {\n  background: linear-gradient(120deg, var(--accent), #35c9c0);\n  border-color: transparent;\n  color: #04140f;\n}\n\n.button-ghost:hover { border-color: var(--line-strong); color: var(--accent); }\n\n.hero-facts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 28px;\n  margin: 0;\n  padding-top: 22px;\n  border-top: 1px solid var(--line);\n}\n\n.hero-facts div { min-width: 110px; }\n\n.hero-facts dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; color: var(--muted); text-transform: uppercase; }\n\n.hero-facts dd { margin: 4px 0 0; font-size: 15px; font-weight: 600; }\n\n/* 闆疯揪 */\n\n.hero-radar {\n  position: relative;\n  aspect-ratio: 1 / 1;\n  border-radius: 50%;\n  border: 1px solid var(--line);\n  background:\n    radial-gradient(circle at 50% 50%, rgba(78, 224, 168, 0.12), transparent 62%),\n    var(--panel-solid);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n  isolation: isolate;\n}\n\n.radar-caption {\n  position: absolute;\n  top: 22px;\n  left: 50%;\n  transform: translateX(-50%);\n  text-align: center;\n  font-family: var(--mono);\n  letter-spacing: 0.16em;\n  z-index: 4;\n}\n\n.radar-caption span { display: block; font-size: 10px; color: var(--muted); }\n\n.radar-caption strong { font-size: 13px; color: var(--accent); }\n\n.radar-grid {\n  position: absolute;\n  inset: 0;\n  background-image:\n    linear-gradient(rgba(120, 219, 190, 0.07) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(120, 219, 190, 0.07) 1px, transparent 1px);\n  background-size: 34px 34px;\n  mask-image: radial-gradient(circle at 50% 50%, #000 55%, transparent 78%);\n  -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 55%, transparent 78%);\n}\n\n.radar-ring {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  border: 1px solid var(--line);\n  border-radius: 50%;\n}\n\n.radar-ring-outer { width: 78%; height: 78%; }\n.radar-ring-middle { width: 54%; height: 54%; border-style: dashed; }\n.radar-ring-inner { width: 30%; height: 30%; }\n\n.radar-axis { position: absolute; background: var(--line); }\n\n.radar-axis-x { top: 50%; left: 8%; right: 8%; height: 1px; }\n\n.radar-axis-y { left: 50%; top: 8%; bottom: 8%; width: 1px; }\n\n.radar-sweep {\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: conic-gradient(from 0deg, rgba(78, 224, 168, 0.34), rgba(78, 224, 168, 0) 28%, transparent 100%);\n  animation: sweep 6.5s linear infinite;\n  z-index: 2;\n}\n\n@keyframes sweep { to { transform: rotate(360deg); } }\n\n.radar-core {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  z-index: 3;\n  display: grid;\n  place-items: center;\n  width: 34%;\n  aspect-ratio: 1 / 1;\n  border-radius: 50%;\n  background: rgba(6, 18, 16, 0.92);\n  border: 1px solid var(--line-strong);\n  text-align: center;\n  padding: 8px;\n}\n\n.radar-core span { font-family: var(--mono); font-size: 22px; color: var(--accent); }\n\n.radar-core strong { font-size: 13px; }\n\n.radar-core small { font-size: 10px; color: var(--muted); line-height: 1.3; }\n\n.radar-node {\n  position: absolute;\n  z-index: 4;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 5px 11px;\n  border-radius: 999px;\n  border: 1px solid var(--line);\n  background: rgba(6, 18, 16, 0.86);\n  font-size: 12px;\n  color: var(--text-dim);\n}\n\n.radar-node i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }\n\n.node-1 { top: 20%; left: 6%; }\n.node-2 { top: 28%; right: 4%; }\n.node-3 { bottom: 22%; left: 12%; }\n.node-4 { bottom: 15%; right: 10%; }\n\n/* ---------------------------------------------- 鎸囨爣鍗?*/\n\n.metrics {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 16px;\n  padding-bottom: clamp(36px, 5vw, 64px);\n}\n\n.metric-card {\n  position: relative;\n  padding: 20px 20px 18px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--panel);\n  overflow: hidden;\n}\n\n.metric-card::after {\n  content: \"\";\n  position: absolute;\n  inset: auto 0 0 0;\n  height: 2px;\n  background: linear-gradient(90deg, var(--accent), transparent);\n  opacity: 0.6;\n}\n\n.metric-index { position: absolute; top: 14px; right: 16px; font-family: var(--mono); font-size: 11px; color: var(--muted); }\n\n.metric-label { display: block; font-size: 13px; color: var(--muted); margin-bottom: 8px; }\n\n.metric-card strong { display: block; font-size: 30px; font-family: var(--mono); color: var(--accent); line-height: 1.2; }\n\n.metric-card small { display: block; margin-top: 6px; color: var(--muted); font-size: 12px; }\n\n/* ---------------------------------------------- 娈佃惤鏍囬 */\n\n.section-heading {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 20px;\n  align-items: flex-end;\n  justify-content: space-between;\n  margin-bottom: 28px;\n}\n\n.section-heading.compact { align-items: center; }\n\n.section-heading p { margin: 8px 0 0; max-width: 62ch; }\n\n.section-note { font-size: 14px; color: var(--muted); }\n\n.legend { display: flex; gap: 16px; font-size: 13px; color: var(--text-dim); flex-wrap: wrap; }\n\n.legend span { display: inline-flex; align-items: center; gap: 7px; }\n\n.status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }\n\n.status-online { background: var(--accent); box-shadow: 0 0 10px rgba(78, 224, 168, 0.7); }\n\n.status-watch { background: var(--watch); box-shadow: 0 0 10px rgba(255, 201, 92, 0.6); }\n\n.status-standby { background: var(--standby); }\n\n/* ---------------------------------------------- 鏈哄埗鍗＄墖 */\n\n.mechanism-section { padding-bottom: clamp(40px, 6vw, 72px); }\n\n.mechanism-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));\n  gap: 16px;\n}\n\n.mechanism-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 22px 20px 18px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: linear-gradient(180deg, rgba(14, 33, 29, 0.9), rgba(8, 20, 18, 0.9));\n  transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;\n}\n\n.mechanism-card:hover {\n  transform: translateY(-4px);\n  border-color: var(--line-strong);\n  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);\n}\n\n.mechanism-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n\n.mechanism-index { font-family: var(--mono); font-size: 12px; color: var(--muted); letter-spacing: 0.14em; }\n\n.status-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border-radius: 999px;\n  font-size: 12px;\n  border: 1px solid transparent;\n  white-space: nowrap;\n}\n\n.status-pill i { width: 6px; height: 6px; border-radius: 50%; }\n\n.status-pill.is-online { color: var(--accent); background: var(--accent-soft); border-color: rgba(78, 224, 168, 0.3); }\n\n.status-pill.is-online i { background: var(--accent); }\n\n.status-pill.is-watch { color: var(--watch); background: var(--watch-soft); border-color: rgba(255, 201, 92, 0.3); }\n\n.status-pill.is-watch i { background: var(--watch); }\n\n.status-pill.is-standby { color: var(--standby); background: var(--standby-soft); border-color: rgba(143, 157, 173, 0.3); }\n\n.status-pill.is-standby i { background: var(--standby); }\n\n.mechanism-name { font-size: 19px; font-weight: 650; }\n\n.mechanism-en { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; color: var(--muted); text-transform: uppercase; }\n\n.mechanism-summary { font-size: 14px; color: var(--text-dim); margin: 0; flex: 1 1 auto; }\n\n.mechanism-foot {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding-top: 12px;\n  border-top: 1px solid var(--line);\n  font-size: 13px;\n}\n\n.mechanism-link { color: var(--accent); font-weight: 600; }\n\n.mechanism-link:hover { text-decoration: underline; }\n\n.mechanism-metric { font-family: var(--mono); font-size: 11px; color: var(--muted); }\n\n.loading-card {\n  display: grid;\n  place-items: center;\n  gap: 12px;\n  min-height: 160px;\n  grid-column: 1 / -1;\n  border: 1px dashed var(--line);\n  border-radius: var(--radius);\n  color: var(--muted);\n}\n\n.loader {\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  border: 2px solid var(--line-strong);\n  border-top-color: var(--accent);\n  animation: spin 0.9s linear infinite;\n}\n\n@keyframes spin { to { transform: rotate(360deg); } }\n\n.data-note { margin-top: 16px; font-size: 13px; color: var(--muted); font-family: var(--mono); min-height: 20px; }\n\n.data-note.is-warn { color: var(--watch); }\n\n/* ---------------------------------------------- 闂幆娴佺▼ */\n\n.flow-section { padding-bottom: clamp(40px, 6vw, 72px); }\n\n.flow-track {\n  list-style: none;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 14px;\n  margin: 0;\n  padding: 0;\n  counter-reset: flow;\n}\n\n.flow-track li {\n  position: relative;\n  display: flex;\n  gap: 14px;\n  padding: 20px 18px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--panel);\n}\n\n.flow-track li::before {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  right: -14px;\n  width: 14px;\n  height: 1px;\n  background: var(--line-strong);\n}\n\n.flow-track li:last-child::before { display: none; }\n\n.flow-index { font-family: var(--mono); font-size: 12px; color: var(--accent); }\n\n.flow-track strong { display: block; font-size: 16px; }\n\n.flow-track small { color: var(--muted); font-size: 13px; }\n\n/* ---------------------------------------------- 鎺у埗鍙板弻鏍?*/\n\n.console-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n  gap: 18px;\n  padding-bottom: clamp(48px, 7vw, 88px);\n}\n\n.panel {\n  padding: 22px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-lg);\n  background: var(--panel);\n}\n\n.panel-heading {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 14px;\n  margin-bottom: 18px;\n}\n\n.panel-heading .eyebrow { margin-bottom: 6px; }\n\n.panel-code { font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; color: var(--muted); }\n\n.status-list { display: flex; flex-direction: column; gap: 2px; }\n\n.status-row {\n  display: grid;\n  grid-template-columns: 1fr auto auto;\n  align-items: center;\n  gap: 12px;\n  padding: 11px 4px;\n  border-bottom: 1px dashed var(--line);\n}\n\n.status-row:last-child { border-bottom: none; }\n\n.status-row .status-name { font-size: 14px; }\n\n.status-row .status-code { font-family: var(--mono); font-size: 11px; color: var(--muted); }\n\n.principle-list { display: flex; flex-direction: column; gap: 14px; }\n\n.principle-list > div {\n  display: flex;\n  gap: 14px;\n  padding: 14px 16px;\n  border-radius: var(--radius-sm);\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid var(--line);\n}\n\n.principle-list > div > span { font-family: var(--mono); font-size: 12px; color: var(--accent); }\n\n.principle-list p { margin: 0; font-size: 14px; }\n\n.principle-list strong { display: block; color: var(--text); margin-bottom: 4px; }\n\n/* ---------------------------------------------- 椤佃剼 */\n\n.site-footer {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 24px;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding: 34px 0 48px;\n  border-top: 1px solid var(--line);\n  margin-top: 20px;\n}\n\n.footer-brand { margin-bottom: 10px; }\n\n.footer-brand span { display: flex; flex-direction: column; line-height: 1.2; }\n\n.footer-brand strong { font-size: 14px; }\n\n.footer-brand small { font-size: 11px; color: var(--muted); letter-spacing: 0.14em; }\n\n.site-footer p { max-width: 46ch; font-size: 13px; color: var(--muted); }\n\n.footer-meta {\n  font-family: var(--mono);\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  text-align: right;\n  color: var(--muted) !important;\n  line-height: 1.9;\n}\n\n/* ---------------------------------------------- 鏈哄埗璇︽儏椤?*/\n\n.breadcrumb {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  padding-top: 26px;\n  font-family: var(--mono);\n  font-size: 12px;\n  color: var(--muted);\n  flex-wrap: wrap;\n}\n\n.breadcrumb a { color: var(--text-dim); }\n\n.breadcrumb a:hover { color: var(--accent); }\n\n.page-hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.75fr);\n  gap: clamp(24px, 4vw, 48px);\n  align-items: center;\n  padding: clamp(34px, 5vw, 62px) 0 clamp(28px, 4vw, 44px);\n}\n\n.page-hero h1 { font-size: clamp(28px, 3.6vw, 44px); }\n\n.page-lead { margin-top: 16px; font-size: 16.5px; max-width: 60ch; }\n\n.page-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 22px;\n  margin-top: 24px;\n  padding-top: 20px;\n  border-top: 1px solid var(--line);\n}\n\n.page-meta div { min-width: 120px; }\n\n.page-meta dt,\n.spec-list dt {\n  font-family: var(--mono);\n  font-size: 11px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.page-meta dd { margin: 4px 0 0; font-size: 15px; font-weight: 600; }\n\n.diagram {\n  position: relative;\n  display: grid;\n  gap: 12px;\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-lg);\n  background: var(--panel-solid);\n  box-shadow: var(--shadow);\n}\n\n.diagram-title { font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; color: var(--muted); text-transform: uppercase; }\n\n.diagram-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 14px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.02);\n  font-size: 14px;\n}\n\n.diagram-row .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex: 0 0 auto; }\n\n.diagram-row .dot.warn { background: var(--watch); }\n\n.diagram-row .dot.standby { background: var(--standby); }\n\n.diagram-row .tag { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted); }\n\n.diagram-arrow { text-align: center; color: var(--muted); font-size: 13px; font-family: var(--mono); }\n\n.doc-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(250px, 320px);\n  gap: clamp(22px, 3.5vw, 40px);\n  align-items: start;\n  padding-bottom: clamp(40px, 6vw, 72px);\n}\n\n.doc-main { display: flex; flex-direction: column; gap: 18px; }\n\n.doc-block {\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-lg);\n  background: var(--panel);\n}\n\n.doc-block h2 { font-size: 21px; margin-bottom: 14px; }\n\n.doc-block h3 { font-size: 16px; margin: 18px 0 8px; }\n\n.doc-block p:last-child,\n.doc-block ul:last-child,\n.doc-block ol:last-child { margin-bottom: 0; }\n\n.doc-block ul,\n.doc-block ol { margin: 0 0 14px; padding-left: 22px; color: var(--text-dim); }\n\n.doc-block li { margin-bottom: 9px; }\n\n.doc-block li::marker { color: var(--accent); font-family: var(--mono); }\n\n.doc-aside { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 92px; }\n\n.doc-aside .panel { padding: 20px; }\n\n.doc-aside h3 { font-size: 15px; margin-bottom: 14px; }\n\n.spec-list { display: grid; gap: 12px; margin: 0; }\n\n.spec-list > div { display: grid; gap: 3px; padding-bottom: 10px; border-bottom: 1px dashed var(--line); }\n\n.spec-list > div:last-child { border-bottom: none; padding-bottom: 0; }\n\n.spec-list dd { margin: 0; font-size: 14px; color: var(--text); }\n\n.spec-list dd code,\n.doc-block code {\n  font-family: var(--mono);\n  font-size: 12.5px;\n  padding: 2px 6px;\n  border-radius: 6px;\n  background: rgba(78, 224, 168, 0.1);\n  color: var(--accent);\n}\n\n.doc-block pre {\n  margin: 0 0 14px;\n  padding: 16px 18px;\n  overflow-x: auto;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--line);\n  background: rgba(3, 10, 9, 0.75);\n}\n\n.doc-block pre code {\n  padding: 0;\n  background: none;\n  color: var(--text-dim);\n  font-size: 12.5px;\n  line-height: 1.75;\n  white-space: pre;\n}\n\n.link-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }\n\n.link-list a {\n  display: flex;\n  gap: 10px;\n  align-items: baseline;\n  padding: 9px 12px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--line);\n  font-size: 13.5px;\n  color: var(--text-dim);\n  transition: border-color 0.2s, color 0.2s, background 0.2s;\n}\n\n.link-list a:hover { color: var(--accent); border-color: var(--line-strong); background: rgba(78, 224, 168, 0.06); }\n\n.link-list .idx { font-family: var(--mono); font-size: 11px; color: var(--muted); }\n\n.callout {\n  display: flex;\n  gap: 14px;\n  padding: 16px 18px;\n  border-radius: var(--radius-sm);\n  border: 1px solid rgba(255, 201, 92, 0.32);\n  background: var(--watch-soft);\n  font-size: 14px;\n  color: var(--text-dim);\n}\n\n.callout strong { color: var(--watch); }\n\n.callout.is-danger { border-color: rgba(255, 122, 122, 0.32); background: rgba(255, 122, 122, 0.12); }\n\n.callout.is-danger strong { color: var(--danger); }\n\n.signal-table { width: 100%; border-collapse: collapse; font-size: 14px; }\n\n.signal-table th,\n.signal-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }\n\n.signal-table th { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 500; }\n\n.signal-table td { color: var(--text-dim); }\n\n.signal-table tr:last-child td { border-bottom: none; }\n\n.step-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: step; }\n\n.step-list li {\n  display: flex;\n  gap: 14px;\n  padding: 14px 16px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.02);\n  color: var(--text-dim);\n  font-size: 14.5px;\n}\n\n.step-list li::before {\n  counter-increment: step;\n  content: counter(step, decimal-leading-zero);\n  font-family: var(--mono);\n  font-size: 12px;\n  color: var(--accent);\n  flex: 0 0 auto;\n  padding-top: 2px;\n}\n\n.pager {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  justify-content: space-between;\n  align-items: center;\n  padding: 22px 0 10px;\n  border-top: 1px solid var(--line);\n}\n\n.pager-links { display: flex; gap: 12px; flex-wrap: wrap; }\n\n.pager .button { padding: 10px 18px; font-size: 14px; }\n\n.pager-index { color: var(--muted); font-family: var(--mono); font-size: 12px; }\n\n/* ---------------------------------------------- 鍔ㄦ晥 */\n\n.reveal {\n  opacity: 0;\n  transform: translateY(16px);\n  transition: opacity 0.6s ease, transform 0.6s ease;\n}\n\n.reveal.is-visible { opacity: 1; transform: none; }\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.001ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.001ms !important;\n    scroll-behavior: auto !important;\n  }\n  .reveal { opacity: 1; transform: none; }\n}\n\n/* ---------------------------------------------- 鍝嶅簲寮?*/\n\n@media (max-width: 1024px) {\n  .hero { grid-template-columns: 1fr; }\n  .hero-radar { max-width: 420px; margin-inline: auto; width: 100%; }\n  .doc-layout { grid-template-columns: 1fr; }\n  .doc-aside { position: static; }\n  .page-hero { grid-template-columns: 1fr; }\n}\n\n@media (max-width: 760px) {\n  body { font-size: 15px; }\n  .section-shell { width: calc(100% - 32px); }\n  .topbar { gap: 12px; flex-wrap: wrap; }\n  .topnav { order: 3; width: 100%; margin-inline: 0; }\n  .topbar-meta { margin-left: auto; }\n  .live-indicator span { display: none; }\n  .hero-facts { gap: 18px; }\n  .footer-meta { text-align: left; }\n  .flow-track li::before { display: none; }\n  .status-row { grid-template-columns: 1fr auto; }\n  .status-row .status-code { display: none; }\n  .doc-block, .panel { padding: 18px; }\n}\n\n@media (max-width: 520px) {\n  .hero-actions .button { width: 100%; justify-content: center; }\n  .pager { flex-direction: column; align-items: stretch; }\n  .pager-links .button { flex: 1 1 auto; justify-content: center; }\n}\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command 'Get-Content testproj/assets/app.js -Raw'","aggregated_output":"/* ============================================================\n   Agent 鐩戠绯荤粺鐩戞帶鍙?路 鍓嶇閫昏緫\n   绾潤鎬? 璇诲彇 data/mechanisms.json 娓叉煋鎬昏椤?   椤甸潰閫氳繃 <html data-root=\"..\"> 澹版槑绔欑偣鏍圭浉瀵硅矾寰?   ============================================================ */\n(function () {\n  \"use strict\";\n\n  var DOC = document.documentElement;\n  var ROOT = DOC.getAttribute(\"data-root\") || \".\";\n  var jsonUrl = (ROOT === \".\" ? \"\" : ROOT + \"/\") + \"data/mechanisms.json\";\n\n  /* file:// 鐩存帴鎵撳紑鏃舵祻瑙堝櫒浼氭嫤鎴湰鍦?JSON 璇诲彇, 杩欓噷淇濈暀涓€浠藉唴缃壇鏈厹搴?\n     淇濊瘉 <a href=\"index.html\"> 鍙屽嚮鎵撳紑涔熻兘鐪嬪埌瀹屾暣鍐呭銆傜湡瀹炴暟鎹粛浠?JSON 涓哄噯銆?*/\n  var FALLBACK = {\n    meta: { title: \"Agent 鐩戠绯荤粺鐩戞帶鍙?, updated: \"2026-09-13\", source: \"鍐呯疆鍓湰\" },\n    mechanisms: [\n      { id: \"01\", name: \"蹇冭烦妫€娴?, nameEn: \"Heartbeat\", slug: \"heartbeat\", page: \"pages/01-heartbeat.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"闂撮殧 30s / 闃堝€?90s\", summary: \"浠ュ甫闃舵淇℃伅鐨勫績璺冲垽瀹?Agent 鏄瓨娲汇€佺┖杞繕鏄凡缁忓兊姝汇€? },\n      { id: \"02\", name: \"鎸囨暟閫€閬?, nameEn: \"Exponential Backoff\", slug: \"backoff\", page: \"pages/02-backoff.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"涓婇檺 120s / 5 娆?, summary: \"澶辫触鍚庢寜鎸囨暟鍔犳姈鍔ㄩ噸璇? 鎶婇噸璇曢鏆存敹鏁涙垚鍙帶鑺傚銆? },\n      { id: \"03\", name: \"浼氳瘽鎺ョ\", nameEn: \"Session Takeover\", slug: \"takeover\", page: \"pages/03-takeover.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"闈欓粯 15s / 鍗曞啓鑰呴攣\", summary: \"鍘熶細璇濆け鑱斿悗鐢辨棤澶磋繘绋嬬画璺? 鍏ㄧ▼鍙厑璁镐竴涓啓鍏ヨ€呫€? },\n      { id: \"04\", name: \"渚涘簲鍟嗚疆鎹?, nameEn: \"Provider Rotation\", slug: \"rotation\", page: \"pages/04-rotation.html\", status: \"watch\", statusLabel: \"瑙傚療\", metric: \"杩炶触 2 娆″嵆鍒囨崲\", summary: \"褰撳墠绔偣杩炶触鍗冲喎鍗村苟鍒囧埌澶囩敤绔偣, 閬垮厤鏁翠换鍔¤鍗曠偣鎷栨銆? },\n      { id: \"05\", name: \"绔偣鎺㈤拡\", nameEn: \"Endpoint Probe\", slug: \"probe\", page: \"pages/05-probe.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"鍚姩鍓?1 娆℃渶灏忚姹?, summary: \"寮€宸ュ墠鐢ㄦ渶灏忚姹傝瘯娲? 鎶婇厤缃敊鍜岀鐐规晠闅滄尅鍦ㄩ暱浠诲姟涔嬪墠銆? },\n      { id: \"06\", name: \"鍑虹珯浠ｇ悊\", nameEn: \"Egress Proxy\", slug: \"egress\", page: \"pages/06-egress.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"绯荤粺浠ｇ悊 / 閫愯烦鍙鲸\", summary: \"缁熶竴鍑虹珯閾捐矾骞朵繚鐣欐瘡璺虫爣璇? 璁╀唬鐞嗘晠闅滀笉琚鍒ゆ垚妯″瀷鏁呴殰銆? },\n      { id: \"07\", name: \"楠屾敹娓呭崟\", nameEn: \"Acceptance Checklist\", slug: \"checklist\", page: \"pages/07-checklist.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"鍏ㄥ嬀鎵嶅厑璁稿仠姝?, summary: \"鎶婂畬鎴愬畾涔夎惤鎴愬彲鍕鹃€夋潯鐩? 鏈嬀瀹屼笉璁稿甯冪粨鏉熴€? },\n      { id: \"08\", name: \"骞查瀛樻。\", nameEn: \"Intervention Archive\", slug: \"archive\", page: \"pages/08-archive.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"姣忔骞查涓€琛?JSON\", summary: \"鎵€鏈夎嚜鍔ㄥ姩浣滄寜鏃堕棿绾胯惤鐩? 浜嬪悗鍙鐜版瘡涓€娆℃帴绠′笌閫€閬裤€? },\n      { id: \"09\", name: \"鐫＄湢鎶戝埗\", nameEn: \"Sleep Suppression\", slug: \"sleep-guard\", page: \"pages/09-sleep-guard.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"鎸佺画鐢宠 / 鍙仮澶?, summary: \"闀胯窇鏈熼棿闃绘绯荤粺浼戠湢, 缁撴潫鍚庢仮澶嶅師璁剧疆, 涓嶇暀鍓綔鐢ㄣ€? },\n      { id: \"10\", name: \"娣锋矊娴嬭瘯\", nameEn: \"Chaos Testing\", slug: \"chaos\", page: \"pages/10-chaos.html\", status: \"watch\", statusLabel: \"瑙傚療\", metric: \"kill:30 / net:30:120\", summary: \"涓诲姩娉ㄥ叆纭畾鎬х殑杩涚▼涓庣綉缁滄晠闅? 楠岃瘉鑷剤閾捐矾鐪熺殑鐢熸晥銆? },\n      { id: \"11\", name: \"缁堟€佹姤鍛?, nameEn: \"Terminal Report\", slug: \"report\", page: \"pages/11-report.html\", status: \"online\", statusLabel: \"鍦ㄧ嚎\", metric: \"鎴愬姛 / 澶辫触 / 鏀惧純\", summary: \"鎶婁竴娆＄洃绠℃敹鏁涙垚涓€浠界粓鎬佺粨璁? 璁╃粨鏋滀笉鍐嶄緷璧栧彛澶存弿杩般€? },\n      { id: \"12\", name: \"鎺堟潈杈圭晫\", nameEn: \"Authority Boundary\", slug: \"boundary\", page: \"pages/12-boundary.html\", status: \"standby\", statusLabel: \"寰呭懡\", metric: \"鍏佽娓呭崟 / 鎷掔粷娓呭崟\", summary: \"闄愬畾鑷姩鍖栧彲瑙﹀強鐨勮寖鍥? 鏃犱汉鍊煎畧鏃舵妸鍙€犳垚鎹熷鐨勫崐寰勫帇鍒版渶灏忋€? }\n    ]\n  };\n\n  var STATUS_CLASS = { online: \"is-online\", watch: \"is-watch\", standby: \"is-standby\" };\n  var STATUS_ORDER = [\"online\", \"watch\", \"standby\"];\n\n  function esc(v) {\n    return String(v == null ? \"\" : v)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\");\n  }\n\n  function pageHref(page) {\n    return (ROOT === \".\" ? \"\" : ROOT + \"/\") + page;\n  }\n\n  function two(n) { return n < 10 ? \"0\" + n : String(n); }\n\n  /* ---------------------------------------------- 鏃堕挓 */\n\n  function padClock(el, withSeconds) {\n    var d = new Date();\n    var t = two(d.getHours()) + \":\" + two(d.getMinutes());\n    if (withSeconds) { t += \":\" + two(d.getSeconds()); }\n    el.textContent = t;\n    if (el.hasAttribute(\"datetime\")) {\n      el.setAttribute(\"datetime\", d.toISOString());\n    }\n  }\n\n  function initClocks() {\n    var clock = document.getElementById(\"clock\");\n    var footerTime = document.getElementById(\"footer-time\");\n    function tick() {\n      if (clock) { padClock(clock, true); }\n      if (footerTime) {\n        var d = new Date();\n        footerTime.textContent = \"鏈湴鏃堕棿 \" + two(d.getHours()) + \":\" + two(d.getMinutes());\n      }\n    }\n    tick();\n    if (clock) { window.setInterval(tick, 1000); }\n    else if (footerTime) { window.setInterval(tick, 30000); }\n  }\n\n  /* ---------------------------------------------- 婊氬姩鏄剧幇 */\n\n  function initReveal() {\n    var items = Array.prototype.slice.call(document.querySelectorAll(\".reveal\"));\n    if (!items.length) { return; }\n    if (!(\"IntersectionObserver\" in window)) {\n      items.forEach(function (el) { el.classList.add(\"is-visible\"); });\n      return;\n    }\n    var io = new IntersectionObserver(function (entries) {\n      entries.forEach(function (entry) {\n        if (entry.isIntersecting) {\n          entry.target.classList.add(\"is-visible\");\n          io.unobserve(entry.target);\n        }\n      });\n    }, { rootMargin: \"0px 0px -8% 0px\", threshold: 0.08 });\n    items.forEach(function (el, i) {\n      el.style.transitionDelay = (i % 6) * 60 + \"ms\";\n      io.observe(el);\n    });\n  }\n\n  /* ---------------------------------------------- 鎬昏娓叉煋 */\n\n  function cardHtml(m) {\n    var cls = STATUS_CLASS[m.status] || \"is-standby\";\n    return [\n      '<article class=\"mechanism-card reveal\" data-status=\"', esc(m.status), '\">',\n        '<div class=\"mechanism-top\">',\n          '<span class=\"mechanism-index\">', esc(m.id), '</span>',\n          '<span class=\"status-pill ', cls, '\"><i></i>', esc(m.statusLabel), '</span>',\n        '</div>',\n        '<h3 class=\"mechanism-name\">', esc(m.name), '</h3>',\n        '<p class=\"mechanism-en\">', esc(m.nameEn), '</p>',\n        '<p class=\"mechanism-summary\">', esc(m.summary), '</p>',\n        '<div class=\"mechanism-foot\">',\n          '<a class=\"mechanism-link\" href=\"', esc(pageHref(m.page)), '\">鏌ョ湅鏈哄埗 鈫?/a>',\n          '<span class=\"mechanism-metric\">', esc(m.metric), '</span>',\n        '</div>',\n      '</article>'\n    ].join(\"\");\n  }\n\n  function statusRowHtml(m) {\n    var cls = STATUS_CLASS[m.status] || \"is-standby\";\n    return [\n      '<div class=\"status-row\">',\n        '<span class=\"status-name\">', esc(m.id), ' 路 ', esc(m.name), '</span>',\n        '<span class=\"status-code\">', esc(m.nameEn), '</span>',\n        '<span class=\"status-pill ', cls, '\"><i></i>', esc(m.statusLabel), '</span>',\n      '</div>'\n    ].join(\"\");\n  }\n\n  function render(data, source) {\n    var list = (data && data.mechanisms) || [];\n    var grid = document.getElementById(\"mechanism-grid\");\n    var statusList = document.getElementById(\"status-list\");\n    var note = document.getElementById(\"data-note\");\n\n    if (grid) {\n      grid.innerHTML = list.map(cardHtml).join(\"\");\n      grid.setAttribute(\"aria-busy\", \"false\");\n    }\n    if (statusList) {\n      statusList.innerHTML = list.map(statusRowHtml).join(\"\");\n    }\n\n    var online = list.filter(function (m) { return m.status === \"online\"; }).length;\n    var watch = list.filter(function (m) { return m.status === \"watch\"; }).length;\n    var standby = list.length - online - watch;\n\n    var mTotal = document.getElementById(\"metric-mechanisms\");\n    var mOnline = document.getElementById(\"metric-online\");\n    var radarCopy = document.getElementById(\"radar-status-copy\");\n    if (mTotal) { mTotal.textContent = String(list.length); }\n    if (mOnline) { mOnline.textContent = online + \" / \" + list.length; }\n    if (radarCopy) {\n      radarCopy.textContent = \"鍦ㄧ嚎 \" + online + \" 路 瑙傚療 \" + watch + \" 路 寰呭懡 \" + standby;\n    }\n\n    if (note) {\n      var stamp = (data && data.meta && data.meta.updated) || \"-\";\n      if (source === \"fallback\") {\n        note.classList.add(\"is-warn\");\n        note.textContent = \"宸茬敤鍐呯疆鍓湰娓叉煋 (file:// 涓嬫祻瑙堝櫒鎷︽埅鏈湴 JSON 璇诲彇); 鐢ㄦ湰鍦版湇鍔″櫒鎵撳紑鍗冲彲璇诲彇 data/mechanisms.json銆?;\n      } else {\n        note.classList.remove(\"is-warn\");\n        note.textContent = \"鏁版嵁婧?data/mechanisms.json 路 鏇存柊 \" + stamp + \" 路 鍏?\" + list.length + \" 椤?;\n      }\n    }\n\n    initReveal();\n    return list.length;\n  }\n\n  function load() {\n    var grid = document.getElementById(\"mechanism-grid\");\n    if (!grid) { return; }\n    grid.setAttribute(\"aria-busy\", \"true\");\n\n    var done = false;\n    function fallback() {\n      if (done) { return; }\n      done = true;\n      render(FALLBACK, \"fallback\");\n    }\n\n    if (typeof window.fetch !== \"function\") { fallback(); return; }\n\n    window.fetch(jsonUrl, { cache: \"no-store\" })\n      .then(function (res) {\n        if (!res.ok) { throw new Error(\"HTTP \" + res.status); }\n        return res.json();\n      })\n      .then(function (data) {\n        if (done) { return; }\n        done = true;\n        render(data, \"json\");\n      })\n      .catch(function () { fallback(); });\n  }\n\n  function initRefresh() {\n    var btn = document.getElementById(\"refresh-button\");\n    if (!btn) { return; }\n    btn.addEventListener(\"click\", function () {\n      btn.classList.add(\"is-spinning\");\n      window.setTimeout(function () { btn.classList.remove(\"is-spinning\"); }, 500);\n      load();\n    });\n  }\n\n  function init() {\n    initClocks();\n    initRefresh();\n    load();\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init);\n  } else {\n    init();\n  }\n})();\n\r\n","exit_code":0,"status":"completed"}}
