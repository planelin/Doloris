{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"\"C:\\\\windows\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command '$root = (Resolve-Path -LiteralPath '\"'afk-work\\\\testproj').Path; \"'$json = Get-Content -LiteralPath (Join-Path $root '\"'data\\\\mechanisms.json') -Raw -Encoding utf8 | ConvertFrom-Json; \"'$expected = @('\"'01-heartbeat.html','02-backoff.html','03-takeover.html','04-rotation.html','05-probe.html','06-egress.html','07-checklist.html','08-archive.html','09-sleep-guard.html','10-chaos.html','11-report.html','12-boundary.html'); \"'$missing = @($expected | Where-Object { -not (Test-Path -LiteralPath (Join-Path $root \"pages'\"\\\\\"'$($_)\")) }); $badRefs = @(); Get-ChildItem -LiteralPath $root -Recurse -Filter '\"'*.html' | ForEach-Object { \"'$html = Get-Content -LiteralPath $_.FullName -Raw -Encoding utf8; $base = Split-Path -Parent $_.FullName; foreach ($m in [regex]::Matches($html, '\"'(?:href|src)=\\\"([\"'^\"]+)\"'\"')) { \"'$ref = $m.Groups[1].Value; if ($ref -match '\"'\"'^(?:[a-z]+:|#|//)'\"' -or \"'$ref -eq '\"'') { continue }; \"'$clean = ($ref -split '\"'[?#]')[0]; if (\"'$clean -eq '\"'') { continue }; \"'$target = Join-Path $base $clean; if (-not (Test-Path -LiteralPath $target)) { $badRefs += \"$($_.FullName) -> $ref\" } } }; $wrongRefs = Select-String -Path (Join-Path $root '\"'*.html'),(Join-Path \"'$root '\"'pages\\\\*.html') -Pattern '11-boundary\\\\.html|12-report\\\\.html' -ErrorAction SilentlyContinue; \"'$summary = [pscustomobject]@{ Mechanisms=$json.mechanisms.Count; Pages=$expected.Count; MissingPages=$missing.Count; BrokenLocalRefs=$badRefs.Count; WrongFilenameRefs=@($wrongRefs).Count }; $summary | Format-List; if ($missing.Count) { '\"'MISSING:'; \"'$missing }; if ($badRefs.Count) { '\"'BROKEN:'; \"'$badRefs }; if ($wrongRefs) { '\"'WRONG REFERENCES:'; \"'$wrongRefs | Select-Object Path,LineNumber,Line | Format-Table -AutoSize -Wrap }; if ($json.mechanisms.Count -ne 12 -or $missing.Count -ne 0 -or $badRefs.Count -ne 0 -or @($wrongRefs).Count -ne 0) { exit 1 }'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
